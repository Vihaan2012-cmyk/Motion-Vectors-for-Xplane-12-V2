+// MV diagnostic: names an optical-flow / interpolation pass that is handed a
+// NULL resource for a texture binding its shader reads. FFX silently skips
+// binding such a resource (the internalIndex==0 "continue" below), leaving the
+// descriptor unwritten - and the shader then reads an unbound descriptor, which
+// on this GPU is the "virtual address 0x0, Type: Compute" device-lost. This
+// turns that blind fault into the exact pass and binding name. Budget-capped so
+// it cannot flood; the crash lands within a handful of frames anyway.
+static void mvFgLogNullBind(const wchar_t* label, const char* kind, const wchar_t* name)
+{
+    static int budget = 80;
+    if (budget <= 0) return;
+    char l[96] = {0}, n[96] = {0};
+    for (int i = 0; i < 95 && label && label[i]; ++i) l[i] = (char)label[i];
+    for (int i = 0; i < 95 && name  && name[i];  ++i) n[i] = (char)name[i];
+    // Optical-flow dispatch labels are "OF ..."; interpolation "...nterpolation".
+    const bool isView = strstr(kind, "view") != nullptr;
+    const bool offi   = strstr(l, "OF ") || strstr(l, "ptical") || strstr(l, "nterpolation");
+    // A null VIEW is always a defect - log for any pass. A skipped null resource
+    // is normal/optional in the upscaler - only flag it for OF / interpolation.
+    if (!isView && !offi) return;
+    --budget;
+    mvFgTrace("FG NULL BIND: pass '%s' %s binding '%s' is NULL - the shader reads 0x0.",
+              l, kind, n);
+}
