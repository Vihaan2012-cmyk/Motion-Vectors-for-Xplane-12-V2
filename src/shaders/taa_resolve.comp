#version 450

// TAA resolve.
//
// Reads the current frame, reprojects the history through the velocity field
// this project spent its whole life verifying, and blends the two.
//
// The velocity convention is prev - curr, in UV. That is why the history is
// sampled at uv + velocity and not uv - velocity. Getting it backwards does not
// fail - it reprojects twice as far in the wrong direction and reads as heavy
// ghosting. It WAS backwards here for the project's entire life until a direct
// calibration caught it at ratio -1.008, so it is stated rather than inferred.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D uCurrent;
layout(set = 0, binding = 1) uniform sampler2D uHistory;
layout(set = 0, binding = 2) uniform sampler2D uVelocity;
layout(set = 0, binding = 3, rgba16f) uniform writeonly image2D uOutput;

layout(push_constant) uniform Params {
    vec2  invSize;      // 1 / render target size
    float blend;        // weight of the CURRENT frame at rest, 0..1
    float reset;        // 1 = ignore history entirely this frame
} pc;

// ---- YCoCg.
//
// Clipping in RGB clips a cube aligned to the colour axes, which is not the
// shape the neighbourhood actually occupies. YCoCg puts luminance on its own
// axis, and since almost all of the variation across a 3x3 neighbourhood is
// luminance, the box becomes far tighter in the direction that matters and
// looser in the two that do not. The result is less ghosting for the same
// amount of flicker - the only axis on which a TAA can really be traded.
//
// It is also exactly reversible with adds and shifts, so it costs nothing.
vec3 rgbToYCoCg(vec3 c)
{
    return vec3( 0.25 * c.r + 0.5 * c.g + 0.25 * c.b,
                 0.50 * c.r              - 0.50 * c.b,
                -0.25 * c.r + 0.5 * c.g - 0.25 * c.b);
}

vec3 yCoCgToRgb(vec3 c)
{
    float y = c.x, co = c.y, cg = c.z;
    return vec3(y + co - cg, y + cg, y - co - cg);
}

// ---- CATMULL-ROM, FIVE TAPS.
//
// Reprojection lands between texels essentially always, so the history is
// resampled every single frame. Bilinear loses a little sharpness each time and
// the loss compounds: after a second of motion the history is visibly softer
// than the frame it came from, which reads as "TAA is blurry" and gets blamed
// on the blend weight.
//
// Catmull-Rom is sharp enough not to compound. The nine-tap form is separable
// into five bilinear fetches by exploiting that the outer weights are equal and
// opposite in sign - standard, and worth the four extra taps over bilinear.
vec3 sampleHistory(vec2 uv, vec2 texSize, vec2 invSize)
{
    vec2 samplePos = uv * texSize;
    vec2 texPos1   = floor(samplePos - 0.5) + 0.5;
    vec2 f         = samplePos - texPos1;

    vec2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
    vec2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);
    vec2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));
    vec2 w3 = f * f * (-0.5 + 0.5 * f);

    vec2 w12      = w1 + w2;
    vec2 offset12 = w2 / w12;

    vec2 texPos0  = (texPos1 - 1.0) * invSize;
    vec2 texPos3  = (texPos1 + 2.0) * invSize;
    vec2 texPos12 = (texPos1 + offset12) * invSize;

    vec3 t0 = texture(uHistory, vec2(texPos12.x, texPos0.y )).rgb;
    vec3 t1 = texture(uHistory, vec2(texPos0.x,  texPos12.y)).rgb;
    vec3 t2 = texture(uHistory, vec2(texPos12.x, texPos12.y)).rgb;
    vec3 t3 = texture(uHistory, vec2(texPos3.x,  texPos12.y)).rgb;
    vec3 t4 = texture(uHistory, vec2(texPos12.x, texPos3.y )).rgb;

    vec3 result = t0 * w12.x * w0.y
                + t1 * w0.x  * w12.y
                + t2 * w12.x * w12.y
                + t3 * w3.x  * w12.y
                + t4 * w12.x * w3.y;

    // ---- RING SUPPRESSION, AND WHY max(result, 0) WAS NOT ENOUGH.
    //
    // Catmull-Rom's negative lobes overshoot on a hard edge. Clamping the
    // result at zero bounds it but does not stop it: on the boundary between a
    // dark cockpit and a bright sky the overshoot is large, and against an HDR
    // sky at several hundred nits a single texel of undershoot reads as a black
    // speck that the next frame's blend preserves. A capture showed exactly
    // that - dense dark speckle across the upper cockpit, precisely where the
    // strongest luminance edge in the frame sits, and nowhere else.
    //
    // Bounding it to the range of the taps it was built from keeps all of the
    // sharpness on smooth gradients, where the taps are close together and the
    // bound is loose, and removes the overshoot on hard edges, where the taps
    // straddle the discontinuity and the bound is tight. That is the ONLY place
    // ringing exists, so nothing is given up.
    vec3 lo = min(t0, min(t1, min(t2, min(t3, t4))));
    vec3 hi = max(t0, max(t1, max(t2, max(t3, t4))));
    return clamp(result, lo, hi);
}

void main()
{
    ivec2 size = textureSize(uCurrent, 0);
    ivec2 p    = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= size.x || p.y >= size.y) return;

    vec2 uv  = (vec2(p) + 0.5) * pc.invSize;
    vec3 cur = texelFetch(uCurrent, p, 0).rgb;

    // ---- THE PIXEL'S OWN VELOCITY. NOT THE LONGEST IN THE NEIGHBOURHOOD.
    //
    // The usual trick here is to take the longest velocity of the 3x3, so that
    // a background pixel beside a moving object follows the object and the
    // silhouette does not trail. That trick assumes the longest vector belongs
    // to the NEAREST surface, which is true when the only thing moving is an
    // object crossing a static background.
    //
    // It is false here. Thin geometry against sky - the canopy frame, the
    // wipers, aerials - puts wildly different velocities in one 3x3, and the
    // maximum then belongs to whichever fragment happened to be fastest rather
    // than to the surface being shaded. A capture showed the cost precisely: a
    // dense speckled band across the top of the frame, exactly where thin
    // cockpit structure meets sky, and clean everywhere else.
    //
    // Done properly this needs depth, to take the CLOSEST rather than the
    // fastest. There is no depth bound to this pass, so it takes the pixel's
    // own velocity - correct for every pixel, at the cost of some trailing on
    // moving silhouettes, which is the smaller and much more local error.
    vec3 m1 = vec3(0.0), m2 = vec3(0.0);
    for (int dy = -1; dy <= 1; ++dy) {
        for (int dx = -1; dx <= 1; ++dx) {
            ivec2 q = clamp(p + ivec2(dx, dy), ivec2(0), size - 1);
            vec3 c  = rgbToYCoCg(texelFetch(uCurrent, q, 0).rgb);
            m1 += c;
            m2 += c * c;
        }
    }
    vec2 bestVel = texture(uVelocity, uv).xy;

    // ---- VARIANCE CLIPPING, NOT A MIN/MAX BOX.
    //
    // A min/max box over 3x3 is set by its two most extreme texels, so a single
    // specular highlight opens the box wide enough to admit history that has
    // nothing to do with this surface. The mean and standard deviation describe
    // where the neighbourhood actually LIVES, and clipping to mean +/- gamma*sigma
    // ignores the outliers that a min/max box is defined by.
    //
    // gamma = 1.0 is tight and flickers slightly on fine detail; 1.5 is the
    // usual compromise and is what this uses.
    const float gamma = 1.5;
    vec3 mu    = m1 / 9.0;
    vec3 sigma = sqrt(max(m2 / 9.0 - mu * mu, vec3(0.0)));
    vec3 lo    = mu - gamma * sigma;
    vec3 hi    = mu + gamma * sigma;

    vec2 hisUv = uv + bestVel;

    // Off-screen history is not history. A sample outside the frame clamps to
    // an edge texel, and an edge texel repeated over a whole border is the
    // classic TAA smear down the side of the screen.
    bool valid = pc.reset < 0.5
              && hisUv.x >= 0.0 && hisUv.x <= 1.0
              && hisUv.y >= 0.0 && hisUv.y <= 1.0;

    vec3 outColour = cur;
    if (valid) {
        vec3 his = rgbToYCoCg(sampleHistory(hisUv, vec2(size), pc.invSize));

        // Clip toward the mean rather than clamping per channel. Clamping moves
        // the colour to the nearest face of the box, which changes hue on the
        // way; clipping moves it along the line back to the neighbourhood mean,
        // which does not.
        vec3 centre = 0.5 * (hi + lo);
        vec3 extent = 0.5 * (hi - lo) + 1e-5;
        vec3 delta  = his - centre;
        vec3 units  = abs(delta / extent);
        float maxUnit = max(units.x, max(units.y, units.z));
        if (maxUnit > 1.0) his = centre + delta / maxUnit;

        // ---- MORE OF THE CURRENT FRAME WHEN THINGS ARE MOVING FAST.
        //
        // A history that is being resampled a long way each frame has been
        // through many resamples to get here, and each one that crossed a
        // disocclusion or an edge carried some error. Fast motion is also when
        // the eye can least see the noise that a higher current-frame weight
        // adds - so the trade is nearly free in both directions.
        //
        // At rest this is pc.blend. At a velocity of one twentieth of the
        // screen per frame it reaches about 0.5.
        float speed = length(bestVel);
        float w = clamp(pc.blend + speed * 8.0, pc.blend, 0.5);

        outColour = yCoCgToRgb(mix(his, rgbToYCoCg(cur), w));
    }

    imageStore(uOutput, p, vec4(max(outColour, vec3(0.0)), 1.0));
}
