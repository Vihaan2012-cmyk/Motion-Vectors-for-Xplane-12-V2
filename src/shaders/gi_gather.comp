#version 450
// ============================================================== SSGI GATHER
//
// Screen-space global illumination: the bounce light X-Plane does not compute.
//
// For every half-resolution pixel this marches a few rays through the engine's
// OWN depth buffer. A ray that hits something reads the HDR scene colour there
// - that surface's light, arriving here. A ray that escapes the screen reads
// the engine's environment probe cube in that direction, which is why the
// picture does not fall apart at the frame edge the way a pure screen-space
// method does.
//
// ---- WHAT THIS ADDS, AND WHAT IT DELIBERATELY DOES NOT.
//
// The engine already applies environment irradiance to every surface: its
// deferred shader walks u_ibl_probes_count_diffuse probes, samples the cube
// array along the NORMAL at mip 6, and alpha-blends the result. Ambient light
// is therefore already present in the colour this pass reads.
//
// What no irradiance lookup can express is LOCAL COLOURED BOUNCE - a red sign
// tinting the concrete beneath it, a sunlit wing throwing light into the gear
// bay. That delta is this pass's entire job, and it is why a ray that escapes
// the screen contributes ZERO rather than falling back to the probes: the
// probes' light is already counted, and adding it again would simply brighten
// the frame twice.
//
// The one advantage that does survive: radiance is read PRE-TONEMAP, so a
// sunlit surface carries the energy that makes bounce read as light rather
// than as a grey wash - a post-tonemap gather cannot tell a lit wall from
// white paint.
//
// ---- HALF RESOLUTION, ITS OWN HISTORY.
//
// Indirect light is low-frequency, so half resolution costs nothing visible
// and quarters the ray budget. The accumulator is SEPARATE from the colour
// history on purpose: a noisy term inside the colour history widens the
// variance clamp and collapses accumulation - the contact-shadow lesson, paid
// for once already.
//
// Copyright (C) 2026 MotionVectors contributors
// SPDX-License-Identifier: GPL-3.0-or-later

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0) uniform sampler2DArray uScene;    // render res, HDR
layout(binding = 1) uniform sampler2DArray uVel;      // render res, ours
layout(binding = 2) uniform sampler2DArray uDepth;    // render res, engine
layout(binding = 3) uniform sampler2DArray uHistRead; // half res
layout(binding = 4, rgba16f) uniform image2DArray uHistWrite;
layout(binding = 5) uniform sampler2DArray uProbes;   // engine cubemaps
layout(binding = 6) uniform sampler2DArray uNormal;   // engine, spheremap .xy
// The engine's own screen-to-eye coefficients, bound BY REFERENCE to the very
// buffer its deferred shader reads. See the note over eyePosEngine.
layout(binding = 7, std140) uniform EngineGbuf {
    vec4 gViewportSize;        // xy = pixels, zw = 1/pixels
    vec4 gGbufferSize;
    vec4 gProjCoefficients[2];
    vec4 gClipInfo[2];
    vec2 gSampleOffset;
};

layout(push_constant) uniform P {
    ivec2 halfSize;     // dispatch extent
    ivec2 fullSize;     // render resolution
    float edA, edB;     // view = edB / (depth + edA)
    float invProjX;     // 1 / proj[0]
    float invProjY;     // 1 / proj[5]
    float radius;       // ray length ceiling, METRES
    float maxScreenPx;  // and its ceiling in half-res PIXELS - see the note
    float thickness;    // hit tolerance, as a FRACTION of ray length
    float alpha;        // history blend
    float velScale;
    float velYSign;
    float ySign;        // viewport Y flip: framebuffer Y vs clip Y
    float intensity;    // scales the gathered radiance
    int   steps;        // march steps per ray
    int   rays;         // rays per pixel per frame
    int   frame;        // rotates the noise
    int   flags;
    float histReject;   // reprojection depth tolerance, RELATIVE to distance
} pc;

const int GI_PROBES   = 1;   // binding 5 holds real probe data
const int GI_RESET    = 2;   // no usable history
const int GI_ENGINE   = 4;   // bindings 6+7 hold the engine's normals/coeffs

// ---- EYE-SPACE POSITION FROM THE ENGINE'S DEPTH.
//
// The same linearization the resolve uses for AO and contact shadows, so all
// three agree about where a pixel is. A cleared or sky texel yields a distance
// at the far plane and is rejected by the caller rather than marched from.
// ---- THE ENGINE'S OWN RECONSTRUCTION, TRANSCRIBED FROM ITS DEFERRED SHADER.
//
//   z  = (d*clip.x + clip.y) / (d*clip.z + clip.w)
//   xy = ((fragCoord + sampleOffset) * (1/viewport)) * projCoeff.xy
//        + projCoeff.zw,  then * (-z)
//
// Three things this gets right that the hand-rolled version below cannot:
// the depth linearization is RATIONAL rather than a two-constant special
// case; projCoeff.zw is an OFFSET, so an asymmetric frustum works instead of
// being silently mis-projected; and the Y flip and jitter are carried by the
// engine's own coefficients rather than by a sign we deduced.
vec3 eyePos(vec2 uv, float lay, out float dist)
{
    float d = texture(uDepth, vec3(uv, lay)).r;

    if ((pc.flags & GI_ENGINE) != 0) {
        float den = d * gClipInfo[0].z + gClipInfo[0].w;
        if (abs(den) < 1e-12) { dist = 1e9; return vec3(0.0, 0.0, -1e9); }
        float z = (d * gClipInfo[0].x + gClipInfo[0].y) / den;   // negative fwd
        vec2  fc = uv * gViewportSize.xy + gSampleOffset;
        vec2  xy = (fc * gViewportSize.zw) * gProjCoefficients[0].xy
                 + gProjCoefficients[0].zw;
        dist = -z;
        if (dist <= 0.0) dist = 1e9;
        return vec3(xy * (-z), z);
    }

    // Fallback: two constants and a symmetric frustum. edB / den, not
    // -edB / den - see the derivation over mvViewDepth in taa.comp; the
    // negated form returns a negative distance for every valid depth, which
    // here would make the sky test reject every pixel.
    float den = d + pc.edA;
    dist = (abs(den) < 1e-7) ? 1e9 : pc.edB / den;
    if (dist <= 0.0) dist = 1e9;
    // ySign carries X-Plane's negative-height viewport, which the engine's
    // own coefficients carry for us on the path above.
    vec2 ndc = vec2(uv.x * 2.0 - 1.0, (uv.y * 2.0 - 1.0) * pc.ySign);
    return vec3(ndc.x * dist * pc.invProjX, ndc.y * dist * pc.invProjY, -dist);
}

// Eye space back to UV. The inverse of the above, which is what makes a ray
// traced in three dimensions marchable in two.
vec2 eyeToUv(vec3 e)
{
    float z = max(-e.z, 1e-4);
    if ((pc.flags & GI_ENGINE) != 0) {
        // Exact inverse of the engine path: undo the (-z) scale, the affine
        // offset, and the sample offset, in that order.
        vec2 xy = e.xy / (-e.z);
        vec2 t  = (xy - gProjCoefficients[0].zw) /
                  max(abs(gProjCoefficients[0].xy), vec2(1e-9)) *
                  sign(gProjCoefficients[0].xy);
        return t - gSampleOffset * gViewportSize.zw;
    }
    vec2 ndc = vec2(e.x / (z * pc.invProjX), e.y / (z * pc.invProjY));
    ndc.y *= pc.ySign;                       // the inverse of eyePos's flip
    return ndc * 0.5 + 0.5;
}

// ---- NORMALS FROM DEPTH, BEST-OF-FOUR.
//
// No G-buffer normal is bound: reconstructing from depth costs no new binding
// and no identification risk, and the engine's own normal buffer can replace
// this later without changing anything else. The four-triangle pick is what
// stops silhouettes producing normals that face nowhere - taking the naive
// central difference across a depth discontinuity halos every edge.
// ---- THE ENGINE'S OWN NORMAL, WHICH IT HAS AND WE WERE GUESSING AT.
//
// gbuf-normal is R16G16_SFLOAT carrying a Lambert azimuthal (spheremap)
// encoding; its deferred shader decodes exactly this way. Exact at every
// pixel, including the silhouettes where reconstructing from depth
// derivatives has to pick between two triangles and is wrong either way.
vec3 engineNormal(vec2 uv, float lay)
{
    vec2 e = texture(uNormal, vec3(uv, lay)).xy;
    float f = dot(e, e);
    return vec3(e * sqrt(max(0.0, 1.0 - f * 0.25)), 1.0 - f * 0.5);
}

vec3 normalFromDepth(vec2 uv, vec3 c, float lay, vec2 texel)
{
    float dl, dr, du, dd;
    vec3 l = eyePos(uv - vec2(texel.x, 0.0), lay, dl);
    vec3 r = eyePos(uv + vec2(texel.x, 0.0), lay, dr);
    vec3 u = eyePos(uv - vec2(0.0, texel.y), lay, du);
    vec3 d = eyePos(uv + vec2(0.0, texel.y), lay, dd);
    float cz = -c.z;
    vec3 dx = (abs(dl - cz) < abs(dr - cz)) ? (c - l) : (r - c);
    vec3 dy = (abs(du - cz) < abs(dd - cz)) ? (c - u) : (d - c);
    vec3 n = cross(dx, dy);
    float len = length(n);
    return (len > 1e-8) ? n / len : vec3(0.0, 0.0, 1.0);
}

float ign(vec2 p, int frame)
{
    // Frame-rotated by the golden ratio: the pattern must MOVE, or the
    // accumulator sees a fixed screen-anchored texture instead of samples of
    // one integral. That distinction is the whole reason temporal denoising
    // works, and getting it wrong reads as crawling grain.
    p += 5.588238 * float(frame & 63);
    return fract(52.9829189 * fract(dot(p, vec2(0.06711056, 0.00583715))));
}

// Cosine-weighted hemisphere direction around n.
vec3 cosineDir(vec3 n, float u1, float u2)
{
    float r = sqrt(u1);
    float phi = 6.2831853 * u2;
    vec3 t = abs(n.z) < 0.9 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    vec3 tx = normalize(cross(t, n));
    vec3 ty = cross(n, tx);
    return normalize(tx * (r * cos(phi)) + ty * (r * sin(phi)) +
                     n * sqrt(max(1.0 - u1, 0.0)));
}

// The engine's probe cube, sampled as a 2D array with manual face selection -
// the image is bound as an array, not a cube view.
vec3 probe(vec3 dir)
{
    if ((pc.flags & GI_PROBES) == 0) return vec3(0.0);
    vec3 a = abs(dir);
    float face; vec2 uv; float ma;
    if (a.x >= a.y && a.x >= a.z) {
        ma = a.x; face = dir.x > 0.0 ? 0.0 : 1.0;
        uv = vec2(dir.x > 0.0 ? -dir.z : dir.z, -dir.y);
    } else if (a.y >= a.z) {
        ma = a.y; face = dir.y > 0.0 ? 2.0 : 3.0;
        uv = vec2(dir.x, dir.y > 0.0 ? dir.z : -dir.z);
    } else {
        ma = a.z; face = dir.z > 0.0 ? 4.0 : 5.0;
        uv = vec2(dir.z > 0.0 ? dir.x : -dir.x, -dir.y);
    }
    uv = uv / max(ma, 1e-6) * 0.5 + 0.5;
    return max(texture(uProbes, vec3(uv, face)).rgb, vec3(0.0));
}

void main()
{
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= pc.halfSize.x || px.y >= pc.halfSize.y) return;

    const float lay = 0.0;
    const vec2 uv = (vec2(px) + 0.5) / vec2(pc.halfSize);
    const vec2 texel = 1.0 / vec2(pc.fullSize);

    float dist;
    vec3 P = eyePos(uv, lay, dist);

    // Sky and anything at the far plane has no surface to gather onto.
    if (dist > 1e8 || dist <= 0.0) {
        // Alpha carries the surface distance now (see the accumulation), and
        // sky has no surface. Zero means "nothing here", which the rejection
        // test below reads as a reason to distrust this texel entirely rather
        // than as a surface 0 m away.
        imageStore(uHistWrite, ivec3(px, 0), vec4(0.0, 0.0, 0.0, 0.0));
        return;
    }

    // ---- THE RAY IS CAPPED IN PIXELS, NOT ONLY IN METRES.
    //
    // A fixed world-space length is a wildly varying screen-space one. At this
    // projection (proj[0] = 1/invProjX) a length L subtends
    //     px = L * proj[0] * width / (2 * dist)
    // half-resolution pixels. With a 6 m ray and 1477 px of width that is
    //
    //     dist 0.5 m -> 13910 px      dist 100 m ->  70 px
    //     dist   5 m ->  1391 px      dist 300 m ->  23 px
    //
    // so a fixed step count would sample every ~1700 px in the cockpit and
    // every ~3 px in the distance. The near field - the panel, the airframe,
    // where bounce light matters most - would be marched by rays that leap
    // over whole objects and hit nothing but coincidence.
    //
    // Capping the SCREEN length instead makes the step size roughly constant
    // in pixels at every distance, which is the only thing the march actually
    // cares about; the metre ceiling still bounds it far away.
    const float pxPerM = (1.0 / max(pc.invProjX, 1e-6)) *
                         (float(pc.halfSize.x) * 0.5) / max(dist, 1e-3);
    const float effRadius = min(pc.radius, pc.maxScreenPx / max(pxPerM, 1e-6));

    const vec3 N = ((pc.flags & GI_ENGINE) != 0)
                 ? engineNormal(uv, lay)
                 : normalFromDepth(uv, P, lay, texel);
    const float n0 = ign(vec2(px), pc.frame);
    const float n1 = ign(vec2(px) + 17.0, pc.frame + 7);

    vec3 gathered = vec3(0.0);
    const int nRays = clamp(pc.rays, 1, 8);
    const int nSteps = clamp(pc.steps, 2, 32);

    for (int r = 0; r < nRays; ++r) {
        float u1 = fract(n0 + float(r) * 0.618034);
        float u2 = fract(n1 + float(r) * 0.381966);
        vec3 dir = cosineDir(N, u1, u2);

        // Start slightly off the surface: a ray that begins exactly on it
        // hits its own origin at the first step and the whole frame goes dark.
        //
        // Scaled to the RAY, not to the world. An absolute 1 cm is half the
        // ray's entire length at 0.5 m distance (where the pixel cap leaves
        // only ~2 cm of reach), so the ray would have started halfway along
        // itself - the same absolute-versus-relative error as the radius and
        // the hit tolerance, one line further on again.
        vec3 origin = P + N * max(0.05 * effRadius, 0.0005 * dist);
        vec3 target = origin + dir * effRadius;

        vec2 uv0 = eyeToUv(origin);
        vec2 uv1 = eyeToUv(target);
        float z0 = -origin.z, z1 = -target.z;

        bool hit = false;
        vec3 radiance = vec3(0.0);
        // Jittered start so the step pattern does not band across flat ground.
        float jitter = fract(n0 + float(r) * 0.7548777);
        for (int s = 1; s <= nSteps && !hit; ++s) {
            float t = (float(s) - jitter) / float(nSteps);
            vec2 suv = mix(uv0, uv1, t);
            if (any(lessThan(suv, vec2(0.0))) ||
                any(greaterThan(suv, vec2(1.0)))) break;   // left the screen

            float rayZ = mix(z0, z1, t);            // where the ray is
            float sceneDist;
            eyePos(suv, lay, sceneDist);            // what the screen has there
            if (sceneDist >= 1e8) continue;         // sky: nothing to hit

            float diff = rayZ - sceneDist;
            // In FRONT of the ray, and by less than the surface could be
            // thick. Without the thickness bound a distant silhouette counts
            // as an occluder and paints the frame with foreground colour.
            // ---- TOLERANCE SCALES WITH THE RAY, NOT WITH THE WORLD.
            //
            // An absolute 0.5 m was 24.6x the ray length at 0.5 m distance
            // and 0.6x at 100 m: up close every surface within half a metre
            // counted as a hit, so the ray gathered radiance from unrelated
            // foreground geometry and the near field would have been lit by
            // whatever happened to be in front of it. A ray can only
            // plausibly hit something within its OWN length, so the tolerance
            // is a fraction of that, with a floor for depth precision.
            float hitTol = max(pc.thickness * effRadius, 0.001 * sceneDist);
            if (diff > 0.0 && diff < hitTol) {
                radiance = max(texture(uScene, vec3(suv, lay)).rgb, vec3(0.0));
                hit = true;
            }
        }

        // A ray that hits nothing contributes NOTHING. It does not fall back
        // to the environment probes: the engine already applies that ambient
        // itself, so adding it here would count the same light twice and read
        // as a grey wash over the frame. probe() is retained behind
        // taa.gi_probes (default off) for measurement, and returns zero unless
        // that flag is set - so this line is a no-op in the shipped path.
        if (!hit) radiance = probe(dir);
        gathered += radiance;
    }
    gathered /= float(nRays);

    // ---- STORE A RATIO, NOT RAW RADIANCE.
    //
    // The composite multiplies by (1 + gi * strength), and the radiance
    // gathered here is the engine's PRE-TONEMAP HDR: the oracle measured
    // environment_probes at mean 5,625 and max 27,040. Feeding that in raw
    // means currA *= 5001 on the first accumulated frame - a guaranteed
    // white-out, and a strength knob whose usable range would be 0.0002.
    //
    // Dividing by the surface's own luminance makes the stored quantity
    // dimensionless: "how much indirect light arrives here, relative to what
    // this surface already shows". Scale-free, exposure-free, and it keeps
    // the bounce's COLOUR (the divisor is a scalar), which is the entire
    // point - a red sign bleeding onto grey concrete.
    //
    // Clamped because a surface in deep shadow has a near-zero divisor, and
    // an unbounded ratio there would light it more brightly than the sun.
    {
        vec3  local = max(texture(uScene, vec3(uv, lay)).rgb, vec3(0.0));
        float lref  = max(dot(local, vec3(0.2126, 0.7152, 0.0722)), 1e-3);
        gathered = min(gathered / lref, vec3(2.0));
    }

    // ---- ACCUMULATE IN OUR OWN HISTORY.
    //
    // Reprojected by the same velocity the resolve uses; four rays a frame is
    // far too noisy to show directly, and this is where that noise becomes an
    // integral instead of grain.
    vec2 fullUv = uv;
    vec4 vs = texture(uVel, vec3(fullUv, lay));
    bool unwritten = (vs.x < -1000.0 || vs.y < -1000.0);
    vec2 vel = unwritten ? vec2(0.0) : vs.xy * pc.velScale;
    vec2 huv = uv + vec2(vel.x, pc.velYSign * vel.y);

    float a = pc.alpha;
    if ((pc.flags & GI_RESET) != 0 ||
        any(lessThan(huv, vec2(0.0))) || any(greaterThan(huv, vec2(1.0))))
        a = 1.0;

    // ---- HISTORY HAS TO BELONG TO THIS SURFACE. IT WAS NEVER CHECKED.
    //
    // Reprojection lands somewhere plausible; it does not land on the same
    // GEOMETRY. At a silhouette or a disocclusion the fetched texel is another
    // surface's accumulated bounce, and with alpha at 0.08 it takes about a
    // dozen frames to wash out - a smear trailing every moving edge. The
    // resolve guards this with a variance clamp; this pass had nothing.
    //
    // A neighbourhood clamp is the wrong tool here: four rays a frame is far
    // too noisy to build a trustworthy box from, and clamping good history to
    // a noisy current frame would destroy the accumulation this pass exists
    // for. Depth is the cheap, reliable discriminator, and the alpha channel
    // was already there storing a constant 1.0.
    //
    // The tolerance is RELATIVE and deliberately loose. Reprojection points at
    // where the surface WAS, so its recorded distance differs from this
    // frame's by however far the camera travelled along the view axis - at
    // 100 m/s and 60 fps that is 1.7 m, which is 33% of a 5 m surface and 1.7%
    // of a 100 m one. A tight threshold would reject constantly in fast flight
    // and lose all accumulation exactly when it is most needed. A silhouette
    // jump is usually a factor, not a few percent, so a loose test still
    // separates them.
    vec4  h4       = texture(uHistRead, vec3(huv, lay));
    vec3  hist     = h4.rgb;
    float histDist = h4.a;
    // Zero alpha is the sky sentinel, or a texel never written. That one IS
    // binary - there is no partial answer to "this texel has no surface".
    if (histDist <= 0.0) {
        a = 1.0;
    } else {
        // ---- RAMPED, NOT CUT. THE FIRST VERSION WAS A STEP AT THE TOLERANCE.
        //
        // It read: if the reprojected distance disagrees by more than
        // histReject, throw ALL the history away. A pixel just inside the
        // tolerance kept a dozen frames of accumulation and its neighbour just
        // outside kept none, so anywhere the disagreement hovers near the
        // boundary - which is everywhere on a surface at a grazing angle -
        // adjacent pixels flip between the two every frame.
        //
        // That is the same defect that put moving black speckle on the runway
        // paint from the AO march and the contact-shadow march: a hard
        // decision boundary placed in the middle of a continuous quantity.
        // Written here before this pass had ever run, which is the only reason
        // it has not been seen yet.
        //
        // smoothstep over [0.5x, 1.5x] of the tolerance: well-agreeing history
        // is kept whole, badly-disagreeing history is dropped whole, and the
        // band between them blends instead of choosing. Noise near the
        // boundary now moves the weight slightly rather than all the way.
        float rel  = abs(histDist - dist) / max(dist, 1e-3);
        float tol  = max(pc.histReject, 1e-4);
        float bad  = smoothstep(tol * 0.5, tol * 1.5, rel);
        a = mix(a, 1.0, bad);
    }

    vec3 outc = max(mix(hist, gathered, a), vec3(0.0));

    // RAW radiance, never pre-scaled: intensity is applied where the result is
    // consumed. Baking it in here would compound it every frame - the history
    // would be multiplied again on each pass through, and the knob would ramp
    // instead of scale.
    // Alpha is this texel's surface distance, which is what makes the test
    // above possible next frame. Bilinear history fetches blend it across
    // neighbours, and at a depth discontinuity that blend is meaningless - but
    // a meaningless value there differs from dist too, so it rejects, which is
    // the answer wanted at a discontinuity anyway.
    imageStore(uHistWrite, ivec3(px, 0), vec4(outc, dist));
}
