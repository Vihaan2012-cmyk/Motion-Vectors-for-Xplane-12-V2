#version 450
// ================================================================ NN CONV 3x3, TENSOR CORES
//
// The same layer as nn_conv.comp - 3x3 convolution, zero padding, optional
// leaky-ReLU, pooling / x2 upsampling folded into the input read - computed
// as matrix multiplies on the cooperative-matrix hardware.
//
// A workgroup owns a 16x8 pixel tile. Its input, with a one-pixel halo, is
// staged in shared memory CHANNEL-INTERLEAVED: [y][x][channel], cinPad
// channels per texel. For one kernel offset (ky, kx) and one block of 16
// input channels, the 16 pixels of a tile row form a 16x16 matrix A whose
// element (pixel, channel) sits at ((row + ky) * HW + pixel + kx) * cinPad +
// block * 16 + channel: rows are 16 contiguous, aligned halfs at a stride of
// cinPad - a plain row-major load. No im2col copy is made.
//
// The layer's whole weight set - per (offset, channel block) a row-major
// [16 x Npad] fp16 matrix B(channel, output), packed by nnaa.h - is staged in
// shared memory ONCE per workgroup and read by all eight subgroups. The
// first versions loaded B from the storage buffer inside the loop: with two
// workgroups resident per SM that was a chain of 18-27 dependent global
// loads per subgroup and cost 5-10 ms per full-resolution layer, the same
// whatever the tile layout. Everything the MMA loop touches is now in shared
// memory. After the loop the tile is dead, so the fp32 accumulators are
// converted to fp16 and parked in it for the bias / activation / store step -
// the maps are fp16 anyway, and it keeps the shared footprint at ~36 KB.
//
// Padding to multiples of 16 costs extra multiplies (17 -> 32 for the first
// layer) that the tensor cores absorb; the fp32 path is still the fallback
// on devices without VK_KHR_cooperative_matrix (nnaa.h decides at init).
//
// Copyright (C) 2026 MotionVectors contributors
// SPDX-License-Identifier: GPL-3.0-or-later

#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_shader_subgroup_basic : require

layout(local_size_x = 32, local_size_y = 8, local_size_z = 1) in;   // 8 subgroups of 32

layout(binding = 0, rgba16f) uniform readonly  image2DArray uA;
layout(binding = 1, rgba16f) uniform readonly  image2DArray uB;
layout(binding = 2, rgba16f) uniform writeonly image2DArray uOut;
layout(binding = 3, std430) readonly buffer W16  { uvec4 w4[]; } uW;       // packed halfs, see nnaa.h; read 8 at a time
layout(binding = 4, std430) readonly buffer Bias { float b[]; } uBias;     // the fp32 blob (biases only)

layout(push_constant) uniform P {
    ivec2 outSize;
    ivec2 sizeA;
    ivec2 sizeB;
    int   cinA;
    int   cinB;       // 0 = no B
    int   cinPad;     // cinA + cinB rounded up to 16
    int   cout;
    int   nPad;       // cout rounded up to 16 (16 or 32)
    int   wOff;       // in halfs, into uW
    int   bOff;       // in floats, into uBias
    int   modeA;      // 0 direct, 1 pool, 2 up
    int   modeB;
    int   act;
} pc;

// The padded channel widths are SPECIALISATION constants, one pipeline per shape: the
// cooperative-matrix loads take their fast path only with a compile-time stride, and with
// the stride in a push constant every load was emulated element by element (4-9 ms per
// full-resolution layer, tracking the channel count exactly).
layout(constant_id = 0) const int CINPAD = 16;
layout(constant_id = 1) const int NPAD = 16;
const int TW = 16, TH = 8;
const int HW = TW + 2, HH = TH + 2;      // haloed tile
const int MAXCIN = 48;                   // largest padded input (the d1 concat: 24 + 16 -> 48)
const int MAXW = 9216;                   // largest weight set: 9 offsets x 2 blocks x 16 x 32 (the e2 layers)

// Shared arrays sized by the shape: a (16,16) layer needs 10 KB, not 36, and the SM then
// holds four or more workgroups instead of two - the latency hiding this kernel lives on.
// The tile doubles as the fp16 result store after the MMA loop (8 rows x nNb x 256 halfs).
const int TILE_N = CINPAD * HH * HW;
const int RES_N  = 8 * (NPAD / 16) * 256;
shared float16_t tile[TILE_N > RES_N ? TILE_N : RES_N];
shared uvec4     wsh4[9 * (CINPAD / 16) * 16 * NPAD / 8];   // the layer's packed weights, 8 halfs per element

// One channel group (4 channels) of a map at conv-input pixel q (output-res coords). Zero outside.
vec4 readGroup(int which, int mode, ivec2 sz, ivec2 q, int g)
{
    if (q.x < 0 || q.y < 0 || q.x >= pc.outSize.x || q.y >= pc.outSize.y) return vec4(0.0);
    if (mode == 1) {
        ivec2 b = q * 2;
        vec4 s = vec4(0.0);
        for (int y = 0; y < 2; ++y)
            for (int x = 0; x < 2; ++x) {
                ivec2 t = min(b + ivec2(x, y), sz - 1);
                s += (which == 0) ? imageLoad(uA, ivec3(t, g)) : imageLoad(uB, ivec3(t, g));
            }
        return s * 0.25;
    }
    if (mode == 2) {
        vec2 src = max((vec2(q) + 0.5) * 0.5 - 0.5, vec2(0.0));
        ivec2 i0 = ivec2(floor(src));
        vec2  f  = src - vec2(i0);
        ivec2 i1 = min(i0 + 1, sz - 1);
        i0 = min(i0, sz - 1);
        vec4 a00, a10, a01, a11;
        if (which == 0) {
            a00 = imageLoad(uA, ivec3(i0.x, i0.y, g)); a10 = imageLoad(uA, ivec3(i1.x, i0.y, g));
            a01 = imageLoad(uA, ivec3(i0.x, i1.y, g)); a11 = imageLoad(uA, ivec3(i1.x, i1.y, g));
        } else {
            a00 = imageLoad(uB, ivec3(i0.x, i0.y, g)); a10 = imageLoad(uB, ivec3(i1.x, i0.y, g));
            a01 = imageLoad(uB, ivec3(i0.x, i1.y, g)); a11 = imageLoad(uB, ivec3(i1.x, i1.y, g));
        }
        return mix(mix(a00, a10, f.x), mix(a01, a11, f.x), f.y);
    }
    return (which == 0) ? imageLoad(uA, ivec3(q, g)) : imageLoad(uB, ivec3(q, g));
}

// Tile channels c..c+3 (c a multiple of 4) at q, spanning the A/B concat boundary if needed.
vec4 readTileGroup(int c, ivec2 q)
{
    if (c + 3 < pc.cinA)                 return readGroup(0, pc.modeA, pc.sizeA, q, c / 4);
    if (c >= pc.cinA && (c - pc.cinA) % 4 == 0 && c - pc.cinA + 3 < pc.cinB) return readGroup(1, pc.modeB, pc.sizeB, q, (c - pc.cinA) / 4);
    vec4 o = vec4(0.0);
    for (int j = 0; j < 4; ++j) {
        int ch = c + j;
        if (ch < pc.cinA) o[j] = readGroup(0, pc.modeA, pc.sizeA, q, ch / 4)[ch % 4];
        else if (ch - pc.cinA < pc.cinB) { int k = ch - pc.cinA; o[j] = readGroup(1, pc.modeB, pc.sizeB, q, k / 4)[k % 4]; }
    }
    return o;
}

void stage(int i, int nGroups, ivec2 tile0)
{
    int g  = i % nGroups;
    int r  = i / nGroups;
    int ty = r / HW, tx = r - ty * HW;
    ivec2 q = tile0 + ivec2(tx - 1, ty - 1);
    vec4 v = readTileGroup(g * 4, q);
    int base = (ty * HW + tx) * CINPAD + g * 4;
    tile[base]     = float16_t(v.x);
    tile[base + 1] = float16_t(v.y);
    tile[base + 2] = float16_t(v.z);
    tile[base + 3] = float16_t(v.w);
}

void main()
{
    const ivec2 tile0 = ivec2(gl_WorkGroupID.xy) * ivec2(TW, TH);
    const int tid = int(gl_LocalInvocationIndex);
    const int nCb = CINPAD / 16;
    const int nNb = NPAD / 16;

    // ---- stage the layer's weights once per workgroup
    const int nW4 = 9 * nCb * 16 * NPAD / 8;
    const int w0 = pc.wOff / 8;
    for (int i = tid; i < nW4; i += 256) wsh4[i] = uW.w4[w0 + i];

    // ---- stage the haloed tile: HH x HW x nGroups vec4 reads across 256 threads, channel
    // group fastest so consecutive threads write consecutive 8-byte runs of shared memory.
    // Two items per iteration so their image loads are in flight together.
    const int nGroups = CINPAD / 4;
    const int items = nGroups * HH * HW;
    int i = tid;
    for (; i + 256 < items; i += 512) { stage(i, nGroups, tile0); stage(i + 256, nGroups, tile0); }
    if (i < items) stage(i, nGroups, tile0);
    barrier();

    // ---- one subgroup per tile row: 9 offsets x nCb blocks, everything from shared memory
    const int row = int(gl_SubgroupID);
    coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc0 = coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0);
    coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc1 = coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0);
    if (row < 8) {
        for (int k = 0; k < 9; ++k) {
            const int ky = k / 3, kx = k - ky * 3;
            const int abase = ((row + ky) * HW + kx) * CINPAD;
            for (int cb = 0; cb < nCb; ++cb) {
                coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> A;
                coopMatLoad(A, tile, abase + cb * 16, CINPAD, gl_CooperativeMatrixLayoutRowMajor);
                const int wb = (k * nCb + cb) * 16 * NPAD;
                coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> B0;
                coopMatLoad(B0, wsh4, wb / 8, NPAD / 8, gl_CooperativeMatrixLayoutRowMajor);
                acc0 = coopMatMulAdd(A, B0, acc0);
                if (nNb > 1) {
                    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> B1;
                    coopMatLoad(B1, wsh4, wb / 8 + 2, NPAD / 8, gl_CooperativeMatrixLayoutRowMajor);
                    acc1 = coopMatMulAdd(A, B1, acc1);
                }
            }
        }
    }
    barrier();   // every subgroup is done reading the tile: it becomes the result store

    if (row < 8) {
        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> h0 = coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(acc0);
        coopMatStore(h0, tile, (row * nNb + 0) * 256, 16, gl_CooperativeMatrixLayoutRowMajor);
        if (nNb > 1) {
            coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> h1 = coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(acc1);
            coopMatStore(h1, tile, (row * nNb + 1) * 256, 16, gl_CooperativeMatrixLayoutRowMajor);
        }
    }
    barrier();

    // ---- bias, activation, store: each thread handles half the channel groups of one pixel
    const int lane = int(gl_SubgroupInvocationID);
    const int px = lane / 2, par = lane & 1;
    const ivec2 gp = tile0 + ivec2(px, row);
    if (gp.x >= pc.outSize.x || gp.y >= pc.outSize.y) return;
    const int nG = (pc.cout + 3) / 4;
    for (int g = par; g < nG; g += 2) {
        vec4 o = vec4(0.0);
        for (int j = 0; j < 4; ++j) {
            int co = g * 4 + j;
            if (co >= pc.cout) break;
            float v = float(tile[(row * nNb + co / 16) * 256 + px * 16 + (co & 15)]) + uBias.b[pc.bOff + co];
            if (pc.act == 1) v = (v > 0.0) ? v : 0.1 * v;
            o[j] = v;
        }
        imageStore(uOut, ivec3(gp, g), o);
    }
}
