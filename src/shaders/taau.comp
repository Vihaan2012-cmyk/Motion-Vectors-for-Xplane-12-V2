#version 450
// ================================================================== TAAU
//
// TEMPORAL UPSAMPLING. X-Plane renders the scene at a fraction of the display
// resolution and its own FSR - a purely SPATIAL filter - stretches it. This
// replaces that stretch with accumulation: an output-resolution history,
// reprojected every frame by the velocity we inject ourselves, into which each
// jittered low-resolution frame deposits its samples.
//
// The jitter is what makes it work. Frame to frame the render's sample grid
// moves by a sub-pixel offset, so successive frames land on DIFFERENT points
// of the output grid; accumulating them reconstructs detail no spatial filter
// can invent, because the information was never in any single frame.
//
// ---- WHY THIS CAN EXIST HERE AT ALL.
//
// Every upscaler needs colour, depth, motion vectors and the jitter offset.
// The universal integration failure is motion vectors: wrong sign, wrong
// scale, wrong convention, guessed at from outside the engine. We inject ours
// into X-Plane's own vertex shaders, so they are full-coverage and their
// convention was swept empirically rather than assumed - the same velScale /
// velYSign pair the resolve uses, passed in here so the two cannot drift.
//
// ---- STAGE 0 LIVES ON AS THE PROOF.
//
// taa.taau_split writes only that fraction of the screen WIDTH; the rest stays
// X-Plane's own upscale. The seam is a live A/B on one frame. History still
// accumulates across the FULL frame, so moving the split does not disturb it.
//
// Copyright (C) 2026 MotionVectors contributors
// SPDX-License-Identifier: GPL-3.0-or-later

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0) uniform sampler2DArray uSrc;          // low res, resolved
layout(binding = 1, rgba16f) uniform image2DArray uDst;   // X-Plane's output
layout(binding = 2) uniform sampler2DArray uVel;          // low res, ours
layout(binding = 3) uniform sampler2DArray uHistRead;     // output res
layout(binding = 4, rgba16f) uniform image2DArray uHistWrite;

layout(push_constant) uniform P {
    ivec2 outSize;
    ivec2 inSize;
    vec2  shift;        // the unjitter shift S, in low-res UV - same as taa.comp
    float alpha;        // weight of the current frame where it is trusted
    float gain;         // neighbourhood clip width, in sigma
    float velScale;
    float velYSign;
    float split;        // fraction of width written to the screen
    float sharpness;    // Catmull-Rom vs bilinear on the current-frame fetch
    int   layer;
    int   flags;        // see below
} pc;

const int TAAU_RESET      = 1;   // no usable history this frame
const int TAAU_TINT       = 2;   // stain our half, to make the seam obvious
const int TAAU_SHOW_ALPHA = 4;   // draw the blend weight instead of the image

// Catmull-Rom in the 9-tap bilinear form. Used for BOTH the history refetch
// and the current-frame fetch: a bilinear history resample is the classic
// source of TAA softness, and at an upscaling ratio it is worse because the
// resample happens every single frame.
vec3 sampleCR(sampler2DArray tex, vec2 uv, vec2 texSize, float lay)
{
    vec2 samplePos = uv * texSize;
    vec2 texPos1 = floor(samplePos - 0.5) + 0.5;
    vec2 f = samplePos - texPos1;

    vec2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
    vec2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);
    vec2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));
    vec2 w3 = f * f * (-0.5 + 0.5 * f);

    vec2 w12 = w1 + w2;
    vec2 offset12 = w2 / max(w12, vec2(1e-5));

    vec2 tp0  = (texPos1 - 1.0) / texSize;
    vec2 tp3  = (texPos1 + 2.0) / texSize;
    vec2 tp12 = (texPos1 + offset12) / texSize;

    vec3 r = vec3(0.0);
    r += texture(tex, vec3(tp0.x,  tp0.y,  lay)).rgb * w0.x  * w0.y;
    r += texture(tex, vec3(tp12.x, tp0.y,  lay)).rgb * w12.x * w0.y;
    r += texture(tex, vec3(tp3.x,  tp0.y,  lay)).rgb * w3.x  * w0.y;
    r += texture(tex, vec3(tp0.x,  tp12.y, lay)).rgb * w0.x  * w12.y;
    r += texture(tex, vec3(tp12.x, tp12.y, lay)).rgb * w12.x * w12.y;
    r += texture(tex, vec3(tp3.x,  tp12.y, lay)).rgb * w3.x  * w12.y;
    r += texture(tex, vec3(tp0.x,  tp3.y,  lay)).rgb * w0.x  * w3.y;
    r += texture(tex, vec3(tp12.x, tp3.y,  lay)).rgb * w12.x * w3.y;
    r += texture(tex, vec3(tp3.x,  tp3.y,  lay)).rgb * w3.x  * w3.y;
    return max(r, vec3(0.0));
}

void main()
{
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= pc.outSize.x || px.y >= pc.outSize.y) return;

    const float lay = float(pc.layer);
    const vec2  uv  = (vec2(px) + 0.5) / vec2(pc.outSize);
    const vec2  inTexel = 1.0 / vec2(pc.inSize);

    // ---- WHERE THIS OUTPUT PIXEL SITS IN THE JITTERED RENDER.
    //
    // The render was displaced by the jitter, so the sample that belongs at
    // this output position is at uv + S - exactly the shift the resolve uses
    // to unjitter, reused rather than re-derived so the two cannot disagree.
    const vec2 suv = uv + pc.shift;

    vec3 curr = (pc.sharpness > 0.0)
        ? mix(texture(uSrc, vec3(suv, lay)).rgb,
              sampleCR(uSrc, suv, vec2(pc.inSize), lay),
              clamp(pc.sharpness, 0.0, 1.0))
        : texture(uSrc, vec3(suv, lay)).rgb;
    curr = max(curr, vec3(0.0));

    // ---- THE NEIGHBOURHOOD, FROM THE LOW-RESOLUTION FRAME.
    //
    // Mean and variance of the 3x3 around the source position, which is the
    // clip box history has to stay inside. Taps are spaced by a LOW-RES texel:
    // the box has to describe what the render could plausibly contain, not
    // what the output grid could.
    vec3 m1 = vec3(0.0), m2 = vec3(0.0), nmin = vec3(1e30), nmax = vec3(-1e30);
    for (int y = -1; y <= 1; ++y)
        for (int x = -1; x <= 1; ++x) {
            vec3 c = texture(uSrc, vec3(suv + vec2(x, y) * inTexel, lay)).rgb;
            c = max(c, vec3(0.0));
            m1 += c; m2 += c * c;
            nmin = min(nmin, c); nmax = max(nmax, c);
        }
    const vec3 mean  = m1 / 9.0;
    const vec3 sigma = sqrt(max(m2 / 9.0 - mean * mean, vec3(0.0)));
    const vec3 clipLo = max(mean - pc.gain * sigma, nmin);
    const vec3 clipHi = min(mean + pc.gain * sigma, nmax);

    // ---- REPROJECTION, IN THE RESOLVE'S CONVENTION.
    //
    // Velocity lives at render resolution; sampling it in UV makes the
    // resolution difference irrelevant. The sentinel marks pixels no patched
    // shader wrote - sky, cloud, anything unpatched - where a zero vector
    // would be a claim of stillness rather than an absence of information.
    const vec4 vs = texture(uVel, vec3(suv, lay));
    const bool unwritten = (vs.x < -1000.0 || vs.y < -1000.0);
    const vec2 vel = unwritten ? vec2(0.0) : vs.xy * pc.velScale;
    const vec2 huv = uv + vec2(vel.x, pc.velYSign * vel.y);

    const bool offscreen = any(lessThan(huv, vec2(0.0))) ||
                           any(greaterThan(huv, vec2(1.0)));
    const bool reset = (pc.flags & TAAU_RESET) != 0;

    vec3 outc;
    float aUsed;
    if (reset || offscreen) {
        // Nothing to accumulate against: take the frame whole.
        outc = curr;
        aUsed = 1.0;
    } else {
        vec3 hist = sampleCR(uHistRead, huv, vec2(pc.outSize), lay);
        // Clip rather than clamp: history that has drifted outside what the
        // render can currently contain is stale, and the box is the only
        // evidence available about how stale.
        hist = clamp(hist, clipLo, clipHi);

        // ---- HOW MUCH OF THE CURRENT FRAME TO TRUST.
        //
        // At an upscaling ratio a single frame carries only (in/out)^2 of the
        // output's samples, so the base weight is LOWER than native TAA - the
        // detail comes from many frames landing on different sub-pixel
        // positions, not from any one of them.
        //
        // Unwritten pixels are the exception: their vector is absent rather
        // than zero, so reprojection is a guess and history is worth little.
        // Taking the current frame there costs the sky some antialiasing and
        // saves it from smearing across the screen when the camera pans.
        aUsed = unwritten ? max(pc.alpha, 0.5) : pc.alpha;
        outc = mix(hist, curr, aUsed);
    }
    outc = max(outc, vec3(0.0));

    // History covers the WHOLE frame regardless of the split, so moving the
    // split is a display choice and never disturbs the accumulation.
    imageStore(uHistWrite, ivec3(px, pc.layer), vec4(outc, 1.0));

    if (float(px.x) >= float(pc.outSize.x) * pc.split) return;

    vec3 shown = outc;
    if ((pc.flags & TAAU_SHOW_ALPHA) != 0) shown = vec3(aUsed);
    if ((pc.flags & TAAU_TINT) != 0) shown.b = min(shown.b * 1.6 + 0.02, 65000.0);
    imageStore(uDst, ivec3(px, pc.layer), vec4(shown, 1.0));
}
