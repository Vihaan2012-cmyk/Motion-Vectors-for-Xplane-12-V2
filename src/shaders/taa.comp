#version 450

// TEMPORAL ANTIALIASING, REBUILT FROM SCRATCH.
//
// The previous resolve was removed because it could corrupt an entire frame and
// nobody could say which half was wrong - the Vulkan plumbing or the algorithm.
// This one is written so those two can be tested separately: MODE_PASSTHROUGH
// exercises every binding, barrier and dispatch while computing nothing, so a
// clean frame in that mode proves the plumbing before a single history sample
// is taken.
//
// The velocity field underneath is now verified: field against its own clip
// values fails 0 of 386511 pixels, the emitted SPIR-V is spirv-val clean, and
// the rendered field is smooth, zero in the sky, and scales as 1/depth. That
// was never true when the last resolve was written.

layout(local_size_x = 8, local_size_y = 8) in;

// ---- EVERYTHING IS AN ARRAY, INCLUDING THE ONE-LAYER CASE.
//
// gbuffer_lit appears in three shapes across the corpus, and the resolve
// originally handled one:
//
//   2D 0 0 0 1   plain 2D, 1 sample        288 permutations
//   2D 0 1 0 1   ARRAYED, 1 sample         288
//   2D 0 1 1 1   ARRAYED + MULTISAMPLED    576
//
// The arrayed ones are stereo - one layer per eye - and fix_hdr confirms the
// shape independently by binding the HDR image as an arrayed Rgba16f storage
// image. A 2D view of a two-layer target silently reaches layer 0 only, which
// is why the result depended on the camera view.
//
// Rather than compile a 2D variant and an array variant, everything here is
// declared as an array and the layer always builds VK_IMAGE_VIEW_TYPE_2D_ARRAY
// views. A 2D_ARRAY view with layerCount = 1 over a non-array image is legal, so
// the single-layer case falls out as arrayLayers = 1 with no second code path -
// and no second code path is one fewer place for the two to drift apart.
//
// The layer index comes from gl_GlobalInvocationID.z, which is the convention
// X-Plane itself uses throughout: cloud_upscale, fsr and fix_hdr all read the
// eye index from exactly there.

// ---- THE SCENE IS READ-ONLY. THE DISPATCH WRITES HISTORY AND NOTHING ELSE.
//
// The first version bound the scene as a storage image and wrote the result
// back in place, while the neighbourhood clamp read imageLoad(uScene, px+d)
// from the SAME dispatch. Neighbouring workgroups were writing those pixels as
// this one read them, so the 3x3 min/max was computed partly over finished
// output and partly over the original frame - the same race that destroyed the
// single-buffer history, and just as invisible.
//
// Writing only to history removes it: nothing this dispatch reads is anything
// this dispatch writes. The layer then copies history into the scene target
// afterwards, in a separate command where the ordering is explicit.
//
// It also means the scene never needs STORAGE usage. X-Plane creates it with
// SAMPLED and TRANSFER_DST already (usage 0x17), so binding it as a sampler and
// copying into it needs no patched image usage at all - and the vkCreateImage
// interception that added STORAGE_BIT, which crashed the sim once, can go.
layout(binding = 0)          uniform sampler2DArray uScene;    // current frame, read only
layout(binding = 1, rgba16f) uniform image2DArray  uHistory;   // the only thing written
layout(binding = 2)          uniform sampler2DArray uVelocity;
layout(binding = 3)          uniform sampler2DArray uHistorySampler;
// ---- X-PLANE'S OWN PER-PIXEL MOVING-GEOMETRY FLAG.
//
// gbuffer_vel, found in the corpus: a uint image read by ssr_deferred as
// `flags & 4` to choose the LOCAL reprojection matrix over the world one. Bit 2
// is therefore X-Plane's own statement that this pixel is local/moving
// geometry - the airframe, the panel, the prop - exactly the set whose true
// motion our world-reprojection field cannot express. A parked aircraft still
// VIBRATES with the engine; its pixels flicker against the background every
// frame, and accumulating that flicker is the prop halo, the tailwheel streak
// and the cockpit shake in one mechanism.
//
// The correct weight for such a pixel is 1.0: take the current frame, keep no
// history, because the history is of somewhere the geometry no longer is.
// That trades antialiasing on the airframe for the end of its ghosts, which is
// the trade every shipping TAA makes for "responsive" pixels.
//
// When the candidate image has not been identified (flagsValid = 0), a 1x1
// zero-filled fallback is bound - Vulkan requires every statically-used
// binding to be valid even behind a branch - and reads as bit-2-clear, a
// no-op.
layout(binding = 4)          uniform usampler2DArray uFlags;

layout(push_constant) uniform Params {
    vec2  invSize;      // 1 / target size
    vec2  jitter;       // the APPLIED NDC offset this frame - scaled, Y-signed
    float alpha;        // weight of the current frame
    int   mode;         // 0 passthrough, 1 reproject, 2 full
    int   reset;        // 1 = ignore history this frame
    // ---- DID THE CAMERA MOVE THIS FRAME?
    //
    // Needed to read a zero velocity correctly, and that turns out to matter a
    // great deal. Our velocity attachment is CLEARED to zero and written only by
    // the vertex shaders we patched. Clouds never write it - cloud_render_raster
    // outputs data_out0/data_out1 and cloud_render_compute writes
    // img_output_cloud_t / img_output_depth_t, all dedicated cloud targets - and
    // neither does the sky. So at those pixels the field holds zero because
    // NOTHING WROTE THERE, not because the pixel is stationary.
    //
    // Those two cases are indistinguishable per-pixel and need opposite
    // treatment: a genuinely static pixel wants full accumulation, an unwritten
    // one cannot be reprojected at all. One bit from the camera separates them.
    // With the camera still, zero means static and history is perfect; with the
    // camera moving, zero means unknown.
    int   cameraMoved;
    // ---- LOOK AT IT, AND REMOVE ONE INPUT AT A TIME.
    //
    // All live-editable while the sim runs. One picture settled what twenty
    // statistics could not when the velocity field was in doubt, and the cost of
    // that lesson was roughly twenty relaunches - so the ability to draw the
    // intermediate quantities, and to switch between them without restarting, is
    // not a convenience here. It is the method.
    int   viz;
    float vizScale;
    float gain;         // how hard a rejected sample pushes alpha toward 1
    float varClip;      // variance box half-width, in standard deviations
    int   flags;
    // ---- THE CONVENTION, FALSIFIABLE AT LAST.
    //
    // The Y sign and the overall scale of the reprojection offset have been
    // constants reasoned from the negative-viewport analysis - and a wrong sign
    // or scale survives every test run so far: the field LOOKS right in the
    // magnitude view (shape and smoothness carry no sign), and the stop test
    // passes (zero is zero under any convention). What a wrong convention DOES
    // produce is exactly the reported artifact: history fetched near-but-not-at
    // the right spot every frame of motion, edges doubling, texture smearing,
    // none of it while still. So both are live knobs now, and one orbit of the
    // camera per combination replaces an afternoon of reasoning about them.
    float velScale;     // multiplies the fetched vector; 1.0 = shipping belief
    float velYSign;     // -1.0 = shipping belief (negative viewport), +1.0 = flipped
    // 1 when uFlags is X-Plane's real gbuffer_vel; 0 when it is the fallback.
    int   flagsValid;
} pc;

const int FLAG_FREEZE_HISTORY = 1;
const int FLAG_NO_MOTION      = 2;
const int FLAG_NO_ACCUM       = 4;
const int FLAG_REACTIVE       = 8;   // consume the coverage mask in .a
const int FLAG_NO_UNJITTER    = 16;  // sample the raster raw - isolation only

const int VIZ_OFF       = 0;
const int VIZ_MOTION    = 1;   // direction as colour
const int VIZ_MAGNITUDE = 2;   // speed as a heatmap
const int VIZ_INVALID   = 3;   // which pixels were rejected, and why
const int VIZ_HISTORY   = 4;   // the history buffer itself
const int VIZ_WEIGHT    = 5;   // the blend weight actually used
const int VIZ_CLAMP     = 6;   // how far the clamp moved history, in sigma

// A perceptually ordered ramp for the scalar views: black -> blue -> green ->
// yellow -> red. Ordered so that "more" always reads as "hotter" without a
// legend, and so that zero is unambiguously black rather than dark blue - the
// distinction between "no motion" and "a little motion" is exactly the one these
// views exist to make.
vec3 heat(float t)
{
    t = clamp(t, 0.0, 1.0);
    vec3 c;
    if      (t < 0.25) c = mix(vec3(0,0,0),   vec3(0,0,1),   t / 0.25);
    else if (t < 0.50) c = mix(vec3(0,0,1),   vec3(0,1,0),  (t - 0.25) / 0.25);
    else if (t < 0.75) c = mix(vec3(0,1,0),   vec3(1,1,0),  (t - 0.50) / 0.25);
    else               c = mix(vec3(1,1,0),   vec3(1,0,0),  (t - 0.75) / 0.25);
    return c;
}

const int MODE_PASSTHROUGH = 0;
const int MODE_REPROJECT   = 1;
const int MODE_FULL        = 2;
// ---- MODE 3: A CLEAN ROOM. TEXTBOOK TAA, NOTHING ELSE.
//
// Written because debugging MODE_FULL stopped converging. It carries a
// variance-normalised rejection metric, a reactive mask keyed on a coverage
// channel opaque geometry does not write, an unjitter step, a gain that drives
// the weight to 1 on flat ground, and several years of layered corrections -
// and the measured result is that TAA makes a STATIC image 4x less stable than
// no TAA even with reprojection disabled entirely, which is a statement about
// the accumulation and not about any of those knobs.
//
// This path shares only the inputs. It does what every TAA does and no more:
// fetch history along the motion vector, clamp it to the colour range its own
// neighbourhood spans this frame, blend at a fixed weight, store. No gain, no
// sigma, no reactive term, no unjitter, no tonemap round trip. If THIS is
// unstable on a still camera, the fault is in the plumbing around the resolve -
// the history binding or the copy back - and not in any resolve logic, which is
// a different search and a much shorter one.
const int MODE_CLEAN       = 3;

// RGB to YCoCg. The neighbourhood clamp is done in YCoCg because clamping in
// RGB clips hue as well as luminance, which is what turns a rejected sample
// into a coloured speckle rather than a slightly wrong grey.
vec3 rgb2ycocg(vec3 c)
{
    return vec3( 0.25 * c.r + 0.5 * c.g + 0.25 * c.b,
                 0.5  * c.r             - 0.5  * c.b,
                -0.25 * c.r + 0.5 * c.g - 0.25 * c.b);
}

vec3 ycocg2rgb(vec3 c)
{
    return vec3(c.x + c.y - c.z,
                c.x        + c.z,
                c.x - c.y - c.z);
}

// ---- WEIGHT IN TONEMAPPED SPACE, NOT RAW HDR.
//
// The scene is HDR: a specular highlight can be fifty times the neighbourhood
// mean. Computing the variance box on those values makes sigma enormous, so the
// clamp barely constrains history and bright areas keep smearing - which reads
// as a glare that grows as you move. It also lets the clamped YCoCg value
// invert back to NEGATIVE rgb, which appears as black dots along high-contrast
// edges exactly when the camera moves.
//
// tm is applied so that every STATISTIC below is computed on values of
// comparable size - a highlight counts once rather than fifty times. What it is
// NOT used for is producing the output colour; see the note on the missing
// inverse directly beneath.
float luma(vec3 c) { return dot(c, vec3(0.2126, 0.7152, 0.0722)); }
vec3  tm(vec3 c)   { return c / (1.0 + luma(c)); }

// THERE IS DELIBERATELY NO INVERSE HERE.
//
// A previous version had one, and it is what turned the screen white and then
// black. The inverse of tm is c / (1 - luma(c)), which is exact only for values
// that really are tonemapped, where luma < 1 by construction. A value that has
// been clamped PER CHANNEL in YCoCg does not satisfy that - per-channel
// clamping can leave the RGB hull - so luma reaches 1, the epsilon floor
// engages, and the pixel is multiplied by ten thousand.
//
// Guarding the epsilon caps how large the wrong answer gets; it does not make
// the answer right. So tm is used only where its output is CONSUMED as a
// statistic - the mean, the variance, the box, and the weight derived from them
// - and every colour that reaches the output stays linear the whole way. See
// the weight computation in main().

void main()
{
    ivec2 px    = ivec2(gl_GlobalInvocationID.xy);
    int   layer = int(gl_GlobalInvocationID.z);
    // textureSize on an array returns (w, h, layers).
    ivec3 size3 = textureSize(uScene, 0);
    ivec2 size  = size3.xy;
    if (px.x >= size.x || px.y >= size.y || layer >= size3.z) return;

    vec3 curr = texelFetch(uScene, ivec3(px, layer), 0).rgb;

    // ---- STAGE 0: prove the plumbing, compute nothing.
    //
    // Every binding is declared and the dispatch covers the whole image, but
    // the output is the input. If the frame changes at all in this mode the
    // fault is in the wiring - the wrong image bound, a bad barrier, a layout
    // mismatch, the dispatch size - and not in any of the maths below.
    if (pc.mode == MODE_PASSTHROUGH) {
        imageStore(uHistory, ivec3(px, layer), vec4(curr, 1.0));
        return;
    }

    vec2 uv = (vec2(px) + 0.5) * pc.invSize;

    // ---- UNJITTER: read the raster where the geometry actually is.
    //
    // pc.jitter is the NDC offset the vertex splice ADDED this frame - the
    // applied value, not the plugin's request, so scale and Y sign are already
    // in it. The whole raster is displaced by it: colour, velocity and
    // coverage all live at uv + S, while history is stored unjittered (it
    // converges to the mean of the offsets). Fetching current AT uv therefore
    // blends a displaced sample into a stable history, which drags alpha's
    // worth of the displacement into the output every frame - and that is the
    // whole image visibly shaking. Jitter is only invisible when the resolve
    // that consumes it cancels it; this is the cancellation.
    //
    // NDC to UV: uv_x = 0.5 + 0.5*ndc_x but uv_y = 0.5 - 0.5*ndc_y, because
    // the viewport height is negative - the same sign the velocity fetch
    // below already carries.
    // ---- THE SIGN, MEASURED RATHER THAN REASONED.
    //
    // Halving taa.jitter_scale left the shake unchanged in amplitude. An error
    // that does not scale with the offset is not a magnitude mistake, it is a
    // direction one: with the wrong sign the fetch moves AWAY from where the
    // raster was displaced, so the sample lands two jitters from the geometry
    // instead of on it, and doubling the displacement of a value that already
    // changes every frame looks identical at any amplitude - which is exactly
    // what the half-amplitude test showed.
    //
    // The raster was displaced by +jitter, so the geometry that belongs at uv
    // now sits at uv MINUS that displacement in UV units. The Y term keeps its
    // negation because the layer pushes NDC and the viewport height is
    // negative; only the overall direction changes.
    vec2 S = (pc.flags & FLAG_NO_UNJITTER) != 0
           ? vec2(0.0)
           : vec2(-0.5 * pc.jitter.x, 0.5 * pc.jitter.y);

    // ---- THE STORED VALUE IS ALREADY A UV OFFSET.
    //
    // The field holds (prevNDC - currNDC) * 0.5. Since uv = ndc * 0.5 + 0.5,
    // that 0.5 IS the NDC-to-UV conversion - it is not a factor to undo. An
    // earlier version multiplied by 2 and fetched history twice as far as it
    // should, which showed up as horizontal streaking across the whole frame.
    //
    // Y is negated because X-Plane renders with a NEGATIVE viewport height, so
    // ndc_y = +1 is at the TOP and uv_y = 0.5 - 0.5 * ndc_y. That makes
    // d(uv_y) = -vel_y while d(uv_x) = +vel_x. The same sign that took the
    // field's own diagnostic from 4.8 px to 0.0015 px applies here.
    vec4 velS = texture(uVelocity, vec3(uv + S, float(layer)));
    vec2 vel  = velS.xy * pc.velScale;
    // ---- THE COVERAGE MASK (C13 -> C14).
    //
    // The velocity target is RGBA16F and its alpha carries the transparency
    // gate the fragment patcher writes: 1 where opaque geometry owns the
    // pixel, 0 where nothing drew or only transparent texels landed - the sky,
    // and the propeller's blur disc. Those pixels flicker by construction
    // (animated transparency alternates blade and background every frame), and
    // accumulating a flicker is the prop halo and its ground trail. Coverage
    // below half forces the weight to the current frame further down.
    float cov = velS.w;

    // ---- COVERAGE IS A REGION PROPERTY, NOT A PIXEL PROPERTY.
    //
    // With jitter armed, a silhouette pixel's coverage flips above and below
    // one half every frame - the sub-pixel offset moves the edge across the
    // sample point, which is the entire point of jittering. Firing the
    // reactive mask on the CENTRE sample therefore set a=1.0 along every edge
    // in the scene, every frame, and every edge refreshed as raw jittered
    // current: the reported whole-scene shake. The prop disc - the thing the
    // mask exists for - is transparent across a REGION, not along a line, so
    // the mask now fires on the neighbourhood maximum: an edge pixel has an
    // opaque neighbour and stays temporal, the disc interior has none and
    // takes the current frame.
    // ---- AND THIS NEIGHBOURHOOD HAS TO BE READ WHERE THE RASTER IS, TOO.
    //
    // The note above identifies the mechanism exactly, and the neighbourhood
    // maximum is the right mitigation - but it was gathered with texelFetch at
    // integer pixels while the centre coverage is read at uv + S, the jittered
    // position. So the mask still compared a jittered centre against an
    // unjittered neighbourhood, still flipped along every silhouette as the
    // offset moved the edge across the sample point, and still refreshed those
    // pixels as raw current every frame. A mask that fires takes the jittered
    // frame whole, which is why the resulting shake never scaled with the
    // jitter amplitude: it is a threshold flipping, not a displacement.
    float covMax = 0.0;
    vec2 ctsz = 1.0 / vec2(size);
    for (int cy = -1; cy <= 1; ++cy)
        for (int cx = -1; cx <= 1; ++cx)
            covMax = max(covMax, texture(uVelocity,
                vec3(uv + S + vec2(cx, cy) * ctsz, float(layer))).w);
    if ((pc.flags & FLAG_NO_MOTION) != 0) vel = vec2(0.0);
    vec2 hUv  = uv + vec2(vel.x, pc.velYSign * vel.y);

    // ---- THE VIEWS THAT DO NOT DEPEND ON HISTORY.
    //
    // Drawn before any rejection so they describe the FIELD rather than what
    // survived the tests below - which is the whole point of looking at it.
    if (pc.viz == VIZ_MOTION) {
        // Vectors in PIXELS, then to colour around a grey zero. Sky and cloud
        // should be flat grey: they have no vectors, and if they are not grey
        // something wrote there that should not have.
        // Through the SAME convention the fetch uses, or the picture and the
        // consumer can disagree in sign - an instrument must show what is
        // consumed, not what is stored.
        vec2 px2 = vec2(vel.x, pc.velYSign * vel.y) * vec2(size);
        vec3 c = vec3(0.5) + vec3(px2.x, px2.y, 0.0) * 0.02 * pc.vizScale;
        imageStore(uHistory, ivec3(px, layer), vec4(c, 1.0));
        return;
    }
    if (pc.viz == VIZ_MAGNITUDE) {
        // Log scale, because the interesting range spans 0.1 px at the horizon
        // to 60+ px underfoot and a linear ramp shows one or the other. Marks:
        // blue 1 px, green 4, yellow 16, red 64.
        float m = length(vel * vec2(size));
        imageStore(uHistory, ivec3(px, layer),
                   vec4(heat(log2(1.0 + m * pc.vizScale) / 6.0), 1.0));
        return;
    }

    // Off-screen history cannot be reprojected. Falling back to the current
    // frame is correct and visible as a thin band of aliasing at the leading
    // edge, which is the honest artifact - inventing a sample would smear.
    bool valid = all(greaterThanEqual(hUv, vec2(0.0))) &&
                 all(lessThanEqual(hUv, vec2(1.0)));

    // ---- CLOUDS AND SKY: NO VECTOR EXISTS, SO DO NOT REPROJECT.
    //
    // Three facts, each established separately from the shader corpus, and
    // together they say our filter cannot help these pixels and can hurt them:
    //
    //  1. No motion-vector texture exists in X-Plane. The only `vel`-named
    //     buffer is gbuffer_vel, in ssr_deferred alone, typed
    //     %uint 2D 0 1 1 1 and read twice as OpBitwiseAnd %uint_4 - it stores
    //     FLAGS. Object motion is a binary choice between two rigid matrices.
    //  2. Clouds never write the g-buffer, so any velocity sampled at a cloud
    //     pixel belongs to whatever opaque geometry, or sky default, is BEHIND
    //     the cloud. Reprojecting by it fetches an unrelated part of history.
    //  3. cloud_upscale is already a full TAA - two histories, analytic matrix
    //     reprojection, a four-test rejection and its own clamp - running at
    //     sub-resolution, and cloud pixels are deliberately re-noised every
    //     frame by u_cloud_temporal_jitter_t. What reaches us is already
    //     averaged and spatially stretched.
    //
    // So ghosting there is cloud_upscale's own history leaking through our
    // clamp, and no amount of tuning our clamp reaches it. Cloud pixels are also
    // two-valued in depth (Rg16f near and far) so there is not even one
    // unambiguous surface to attach a vector to. Declining is the correct
    // answer, not an approximation of one.
    //
    // The test is principled rather than a colour heuristic: an exactly-zero
    // vector while the camera is moving means no patched shader wrote this
    // pixel. That is precisely the set we cannot reproject - sky, clouds, and
    // any draw whose shader we failed to patch, which is the right set for all
    // three reasons.
    bool noVector = pc.cameraMoved != 0 && vel == vec2(0.0)
                 && (pc.flags & FLAG_NO_MOTION) == 0;

    // ---- WHICH PIXELS WERE REJECTED, AND WHY.
    //
    // The single most useful view here, because it is the only one that can
    // falsify the cloud and sky rejection above. That test claims to select
    // exactly the pixels no patched shader wrote; this draws the set it actually
    // selected, so the claim can be checked by looking instead of argued about.
    //
    //   RED    no vector was written and the camera moved - sky, cloud, or a
    //          shader we failed to patch. Should cover the sky and the clouds
    //          and NOTHING ELSE. Red on terrain means a patching hole.
    //   BLUE   history reprojected off screen. Should be a thin band at the
    //          leading edge, thickening with speed.
    //   GREEN  accepted, reprojected, blended.
    if (pc.viz == VIZ_INVALID) {
        // YELLOW joins the classes: covered by transparent/animated content,
        // which the reactive mask hands to the current frame. The prop disc
        // should be a clean yellow circle; yellow over the whole airframe
        // would mean the gate is misreading opaque geometry.
        vec3 c = noVector    ? vec3(1.0, 0.0, 0.0)
               : !valid     ? vec3(0.0, 0.0, 1.0)
               : (covMax < 0.5 && (pc.flags & FLAG_REACTIVE) != 0)
                            ? vec3(1.0, 1.0, 0.0)
                            : vec3(0.0, 1.0, 0.0);
        imageStore(uHistory, ivec3(px, layer), vec4(c, 1.0));
        return;
    }

    // The aligned read of the current frame. Bilinear, so it costs half a
    // texel of softness at most - the alternative is the displacement itself
    // reaching the screen. Everything below that consumes "the current frame"
    // as a colour consumes this; the raster-space statistics loop keeps its
    // texelFetches because a box built from the actual raster is still the
    // right box, S being well under one texel.
    vec3 currA = texture(uScene, vec3(uv + S, float(layer))).rgb;

    if (pc.reset != 0 || !valid || noVector) {
        imageStore(uHistory, ivec3(px, layer), vec4(currA, 1.0));
        return;
    }

    vec3 hist = texture(uHistorySampler, vec3(hUv, float(layer))).rgb;

    // History straight to screen, before anything is done to it. If this does
    // not smear along motion when frozen, what is displayed is not the history
    // and no amount of tuning the blend will change that.
    if (pc.viz == VIZ_HISTORY) {
        imageStore(uHistory, ivec3(px, layer), vec4(hist, 1.0));
        return;
    }

    // Keep every binding, barrier and dispatch live while removing exactly one
    // thing. FREEZE_HISTORY writes nothing at all, so the buffer retains what it
    // had; NO_ACCUM writes the current frame, so accumulation stops but the
    // pipeline does not.
    if ((pc.flags & FLAG_FREEZE_HISTORY) != 0) return;
    if ((pc.flags & FLAG_NO_ACCUM) != 0) {
        imageStore(uHistory, ivec3(px, layer), vec4(currA, 1.0));
        return;
    }

    // ---- MODE 3: the clean room. See the note at MODE_CLEAN.
    if (pc.mode == MODE_CLEAN) {
        vec2 tszC = 1.0 / vec2(size);
        // Neighbourhood in LINEAR space - no tonemap, so no inverse is ever
        // needed and the epsilon that broke earlier attempts cannot arise.
        vec3 cmin = vec3( 1e30), cmax = vec3(-1e30);
        for (int dy = -1; dy <= 1; ++dy)
            for (int dx = -1; dx <= 1; ++dx) {
                vec3 s = texture(uScene,
                          vec3(uv + vec2(dx, dy) * tszC, float(layer))).rgb;
                cmin = min(cmin, s);
                cmax = max(cmax, s);
            }
        // History along the motion vector, clamped into that range. A sample
        // outside every colour around it cannot belong to this pixel, whatever
        // the vector claimed - that single rule is what stops ghosting, and it
        // needs no variance, no gain and no coverage channel.
        vec3 h = texture(uHistorySampler, vec3(hUv, float(layer))).rgb;
        h = clamp(h, cmin, cmax);
        // First frame, a reset, or a reprojection that left the screen: take
        // the current frame whole rather than blending against nothing.
        bool bad = pc.reset != 0 ||
                   hUv.x < 0.0 || hUv.x > 1.0 || hUv.y < 0.0 || hUv.y > 1.0;
        vec3 o = bad ? currA : mix(h, currA, pc.alpha);
        imageStore(uHistory, ivec3(px, layer), vec4(max(o, vec3(0.0)), 1.0));
        return;
    }

    // ---- STAGE 1: reprojection only, no rejection.
    //
    // Ghosting here is expected and diagnostic: it means history is being
    // fetched and blended, and that the velocity is steering it. A frame that
    // ghosts along motion is a frame whose reprojection works.
    if (pc.mode == MODE_REPROJECT) {
        vec3 outc = mix(hist, currA, pc.alpha);
        imageStore(uHistory, ivec3(px, layer), vec4(outc, 1.0));
        return;
    }

    // ---- STAGE 2: neighbourhood clamp.
    //
    // History that falls outside the range of the current 3x3 neighbourhood is
    // stale - a disocclusion, or a shading change the vectors cannot express.
    // Clamping to that range keeps the sample that is still valid and discards
    // the part that is not, which is what stops ghosting without giving up
    // accumulation everywhere.
    // ---- STATISTICS IN TONEMAPPED SPACE. BLEND IN LINEAR. NEVER INVERT.
    //
    // This is the third attempt and the reasoning matters, because the second
    // one was clever and produced a black screen.
    //
    // Attempt 1 computed the box on raw HDR values. A specular highlight is
    // fifty times the neighbourhood mean there, so sigma is enormous, the clamp
    // barely constrains history, and bright areas keep smearing - the glare
    // that grows as you move. Per-channel clamping in YCoCg can also leave the
    // RGB hull, which inverts back to NEGATIVE rgb: the black dots along
    // high-contrast edges when the camera moves.
    //
    // Attempt 2 applied Karis' reversible weighting - blend in c/(1+luma), then
    // undo it. Both defects are addressed in theory, and untm blew up in
    // practice: the clamped value's luma can reach 1, so 1-luma hits its epsilon
    // floor and the pixel is multiplied by ten thousand. White fireflies frame
    // wide.
    //
    // The inverse was never needed. Only the STATISTICS have to be computed on
    // values of comparable size - the mean, the variance, the box, and the
    // weight derived from them. The blend itself can then be applied to the
    // linear colours with that weight. Nothing is ever mapped back, so there is
    // no epsilon and nothing to divide by.
    vec3 m1 = vec3(0.0), m2 = vec3(0.0);
    vec3 nmin = vec3( 1e30), nmax = vec3(-1e30);
    // ---- THE NEIGHBOURHOOD MUST BE READ WHERE THE CENTRE WAS READ.
    //
    // These taps used texelFetch at integer pixels while the centre sample is
    // taken at uv + S, the jittered position where the geometry actually is.
    // With jitter armed the box was therefore built from a raster half a pixel
    // away from the sample it judges, in a DIFFERENT direction every frame, so
    // history was accepted on one frame and clipped on the next across the
    // whole image. That is the shake that appeared only with jitter on and
    // survived every other fix - the clamp was fighting the jitter it was never
    // told about.
    //
    // Sampling with the same offset costs a filtered fetch instead of a texel
    // fetch and puts the statistics in the sample's own frame of reference.
    vec2 tsz = 1.0 / vec2(size);
    for (int dy = -1; dy <= 1; ++dy) {
        for (int dx = -1; dx <= 1; ++dx) {
            vec2  quv = uv + S + vec2(dx, dy) * tsz;
            vec3  c = rgb2ycocg(tm(texture(uScene, vec3(quv, float(layer))).rgb));
            m1 += c;
            m2 += c * c;
            nmin = min(nmin, c);
            nmax = max(nmax, c);
        }
    }

    // Variance clipping, tightened against the hard min/max. The box alone is
    // too permissive on noisy content and lets fireflies persist; the variance
    // term narrows it where the neighbourhood actually agrees.
    vec3 mu    = m1 / 9.0;
    vec3 sigma = sqrt(max(m2 / 9.0 - mu * mu, vec3(0.0)));
    // ---- TIGHTER IN THE DARK.
    //
    // The shadow interiors mottled because X-Plane dithers its soft shadows
    // per frame and the clamp box, sized by variance, is WIDE exactly where
    // that dither is the dominant signal - so bright dither outliers inside a
    // shadow passed as plausible and parked. Luminance says which regime a
    // pixel is in: below ~2% luminance the box narrows to just over half its
    // width, fading back to full by ~15%. Scaled from pc.varClip so the live
    // knob still moves the whole family together.
    float clipK = pc.varClip * mix(0.55, 1.0,
                                   smoothstep(0.02, 0.15, luma(tm(currA))));
    vec3 lo    = max(mu - clipK * sigma, nmin);
    vec3 hi    = min(mu + clipK * sigma, nmax);

    vec3 hRaw = rgb2ycocg(tm(hist));
    vec3 hy   = clamp(hRaw, lo, hi);

    // ---- HOW FAR THE CLAMP HAD TO MOVE HISTORY, MEASURED SAFELY.
    //
    // A large correction means history was wrong, so trusting it less is
    // cheaper than a second rejection heuristic. But the ratio needs a
    // denominator that cannot vanish independently of the numerator.
    //
    // The floor was an absolute 1e-4, and in a flat region - a sky gradient, a
    // smooth fuselage - both sigma and |hy - hRaw| go to zero together. That
    // makes `moved` a ratio of two vanishing quantities with a floor on only
    // one of them, so a correction far too small to see could drive the weight
    // to 1.0 and kill accumulation exactly where it matters most.
    //
    // Flooring relative to the signal fixes it: below a hundredth of the local
    // luminance the neighbourhood genuinely agrees, history is genuinely fine,
    // and `moved` should read as zero rather than as noise amplified.
    float floorS = 0.01 * luma(tm(currA)) + 1e-4;
    float moved  = length(hy - hRaw) / max(length(sigma), floorS);

    // ---- THE CLAMP DRIVES THE WEIGHT. IT IS NOT APPLIED TO THE COLOUR.
    //
    // This is the part attempt 2 got wrong, and it is worth being precise about
    // why, because the obvious repair is to keep the clamp and pick a safer
    // epsilon - which is the same bug with a smaller blast radius.
    //
    // tm(c) = c / (1 + luma(c)) inverts to tm(c) / (1 - luma(tm(c))). There is
    // no other inverse: recovering a linear colour from a value that was
    // CLAMPED in tonemapped space requires that division, and the clamp is
    // per-channel in YCoCg, so it can push luma to 1 and make the divisor zero.
    // Any epsilon there is a cap on how large a wrong answer gets, not a fix.
    //
    // So the clamp is never inverted. It is used for what it actually measures:
    // HOW WRONG HISTORY IS. `moved` is that distance in units of the local
    // standard deviation, and it drives the weight instead of the colour. A
    // disoccluded pixel, where the clamp would have snapped history a long way,
    // now gets a weight at or near 1.0 and simply takes the current frame - the
    // same outcome, reached without ever leaving linear space.
    //
    // The gain is 4.0 rather than the 0.5 used when clamping did most of the
    // work: at `moved` = 1, one standard deviation out, history is already
    // suspect, and the weight should be most of the way to the current frame.
    // Everything here is a multiply, an add and a clamp - nothing divides by a
    // quantity that can vanish, so there is no configuration of inputs that
    // produces a firefly or a black pixel.
    float a = clamp(pc.alpha + pc.gain * moved * pc.alpha, pc.alpha, 1.0);

    // Moving-geometry pixels take the current frame outright - see uFlags.
    if (pc.flagsValid != 0) {
        // Clamped, unconditionally. texelFetch performs no bounds checking,
        // and this fetch runs at full-frame coordinates against whatever is
        // bound - which is the 1x1 fallback whenever the real image is
        // unidentified. The branch above should keep the fallback unfetched,
        // but an out-of-bounds texelFetch is undefined behaviour of exactly
        // the kind that becomes VK_ERROR_DEVICE_LOST on a driver that hoists,
        // and a clamp costs two instructions against losing the device.
        ivec3 fsz = textureSize(uFlags, 0);
        ivec2 fpx = min(px, fsz.xy - 1);
        uint fl = texelFetch(uFlags, ivec3(fpx, min(layer, fsz.z - 1)), 0).r;
        if ((fl & 4u) != 0u) a = 1.0;
    }
    // Transparent-covered pixels likewise - the C14 reactive mask. See the
    // coverage note at the fetch.
    if ((pc.flags & FLAG_REACTIVE) != 0 && covMax < 0.5) a = 1.0;

    // How far the clamp had to move history, in standard deviations. Edges under
    // motion should light up and flat interiors should stay black; a frame that
    // is bright everywhere means the box is too tight, and one that is black
    // everywhere means it is not constraining anything.
    if (pc.viz == VIZ_CLAMP) {
        imageStore(uHistory, ivec3(px, layer),
                   vec4(heat(moved * 0.5 * pc.vizScale), 1.0));
        return;
    }
    // The weight actually used. Black is full accumulation, white is the current
    // frame only, so disocclusion edges glow and everything static stays dark.
    // This is the view that says whether alpha is doing what the number says.
    if (pc.viz == VIZ_WEIGHT) {
        imageStore(uHistory, ivec3(px, layer),
                   vec4(heat(a * pc.vizScale), 1.0));
        return;
    }

    // The negative-component floor stays. Those were the black dots along
    // high-contrast edges, and flooring costs nothing.
    vec3 outc = max(mix(hist, currA, a), vec3(0.0));

    imageStore(uHistory, ivec3(px, layer), vec4(outc, 1.0));
}
