#version 450

// TEMPORAL ANTIALIASING, REBUILT FROM SCRATCH.
//
// The previous resolve was removed because it could corrupt an entire frame and
// nobody could say which half was wrong - the Vulkan plumbing or the algorithm.
// This one is written so those two can be tested separately: MODE_PASSTHROUGH
// exercises every binding, barrier and dispatch while computing nothing, so a
// clean frame in that mode proves the plumbing before a single history sample
// is taken.
//
// The velocity field underneath is now verified: field against its own clip
// values fails 0 of 386511 pixels, the emitted SPIR-V is spirv-val clean, and
// the rendered field is smooth, zero in the sky, and scales as 1/depth. That
// was never true when the last resolve was written.

layout(local_size_x = 8, local_size_y = 8) in;

// ---- EVERYTHING IS AN ARRAY, INCLUDING THE ONE-LAYER CASE.
//
// gbuffer_lit appears in three shapes across the corpus, and the resolve
// originally handled one:
//
//   2D 0 0 0 1   plain 2D, 1 sample        288 permutations
//   2D 0 1 0 1   ARRAYED, 1 sample         288
//   2D 0 1 1 1   ARRAYED + MULTISAMPLED    576
//
// The arrayed ones are stereo - one layer per eye - and fix_hdr confirms the
// shape independently by binding the HDR image as an arrayed Rgba16f storage
// image. A 2D view of a two-layer target silently reaches layer 0 only, which
// is why the result depended on the camera view.
//
// Rather than compile a 2D variant and an array variant, everything here is
// declared as an array and the layer always builds VK_IMAGE_VIEW_TYPE_2D_ARRAY
// views. A 2D_ARRAY view with layerCount = 1 over a non-array image is legal, so
// the single-layer case falls out as arrayLayers = 1 with no second code path -
// and no second code path is one fewer place for the two to drift apart.
//
// The layer index comes from gl_GlobalInvocationID.z, which is the convention
// X-Plane itself uses throughout: cloud_upscale, fsr and fix_hdr all read the
// eye index from exactly there.

// ---- THE SCENE IS READ-ONLY. THE DISPATCH WRITES HISTORY AND NOTHING ELSE.
//
// The first version bound the scene as a storage image and wrote the result
// back in place, while the neighbourhood clamp read imageLoad(uScene, px+d)
// from the SAME dispatch. Neighbouring workgroups were writing those pixels as
// this one read them, so the 3x3 min/max was computed partly over finished
// output and partly over the original frame - the same race that destroyed the
// single-buffer history, and just as invisible.
//
// Writing only to history removes it: nothing this dispatch reads is anything
// this dispatch writes. The layer then copies history into the scene target
// afterwards, in a separate command where the ordering is explicit.
//
// It also means the scene never needs STORAGE usage. X-Plane creates it with
// SAMPLED and TRANSFER_DST already (usage 0x17), so binding it as a sampler and
// copying into it needs no patched image usage at all - and the vkCreateImage
// interception that added STORAGE_BIT, which crashed the sim once, can go.
layout(binding = 0)          uniform sampler2DArray uScene;    // current frame, read only
layout(binding = 1, rgba16f) uniform image2DArray  uHistory;   // the only thing written
layout(binding = 2)          uniform sampler2DArray uVelocity;
layout(binding = 3)          uniform sampler2DArray uHistorySampler;
// ---- X-PLANE'S OWN PER-PIXEL MOVING-GEOMETRY FLAG.
//
// gbuffer_vel, found in the corpus: a uint image read by ssr_deferred as
// `flags & 4` to choose the LOCAL reprojection matrix over the world one. Bit 2
// is therefore X-Plane's own statement that this pixel is local/moving
// geometry - the airframe, the panel, the prop - exactly the set whose true
// motion our world-reprojection field cannot express. A parked aircraft still
// VIBRATES with the engine; its pixels flicker against the background every
// frame, and accumulating that flicker is the prop halo, the tailwheel streak
// and the cockpit shake in one mechanism.
//
// The correct weight for such a pixel is 1.0: take the current frame, keep no
// history, because the history is of somewhere the geometry no longer is.
// That trades antialiasing on the airframe for the end of its ghosts, which is
// the trade every shipping TAA makes for "responsive" pixels.
//
// When the candidate image has not been identified (flagsValid = 0), a 1x1
// zero-filled fallback is bound - Vulkan requires every statically-used
// binding to be valid even behind a branch - and reads as bit-2-clear, a
// no-op.
layout(binding = 4)          uniform usampler2DArray uFlags;
// ---- X-PLANE'S OWN DEPTH, BOUND STRAIGHT FROM THE ENGINE.
//
// The image the engine itself names "gbuf-depth" - the same buffer its clouds,
// fog, atmosphere and particles all read as gbuffer_pos. Under FLAG_ENGINE_DEPTH
// the AO and contact-shadow marches take their view distance from here instead
// of from the injected clip-w in uVelocity's B channel: the injected value only
// exists where our patched vertex shaders ran, while this exists EVERYWHERE the
// engine drew anything. When the flag is off (or identification has not landed
// yet) binding 5 holds the velocity target as a dummy and is never sampled.
layout(binding = 5)          uniform sampler2DArray uEngineDepth;
// ---- THE REPROJECTION MATRIX, FOR PIXELS THE INJECTION NEVER WROTE.
//
// The SAME unjittered camera-relative matrix the injected vertex shaders
// receive per draw: prevClip = uReproj * currClip. Homogeneous, so a point at
// infinity (sky) becomes a direction and reprojects by ROTATION - which is
// exactly what the sky needs when the camera pans, and it falls out of the
// mathematics rather than being a special case.
//
// uReprojParams: x = the viewport Y sign (framebuffer-UV to NDC), y = 1 when
// the matrix is valid this frame (the plugin could not always invert), zw
// unused. Read only under FLAG_DEPTH_REPROJECT.
layout(binding = 6, std140) uniform ReprojData {
    mat4 uReproj;
    vec4 uReprojParams;
};


layout(push_constant) uniform Params {
    vec2  invSize;      // 1 / target size
    vec2  jitter;       // the APPLIED NDC offset this frame - scaled, Y-signed
    float alpha;        // weight of the current frame
    int   mode;         // 0 passthrough, 1 reproject, 2 full
    // ---- DID THE CAMERA MOVE THIS FRAME? (now FLAG_CAMERA_MOVED in flags)
    //
    // Needed to read a zero velocity correctly: our velocity attachment is
    // CLEARED to zero and written only by the vertex shaders we patched, so an
    // unwritten pixel and a static pixel are indistinguishable per-pixel and
    // need opposite treatment. One bit from the camera separates them - with
    // the camera still, zero means static; moving, zero means unknown.
    // ---- reset and cameraMoved MOVED INTO pc.flags (FLAG_RESET,
    // FLAG_CAMERA_MOVED). The push block sits at the 128-byte guaranteed
    // ceiling, and two int32s that each carried one bit were the only slack.
    // Their four bytes now carry the engine-depth linearization:
    //     view_distance = -edB / (ndc_depth + edA)
    // with edA = proj[10] and edB = proj[14], straight from the projection the
    // plugin already publishes. Works for either depth convention because the
    // constants come from the live matrix rather than from an assumption.
    float edA;
    // ---- DID THE CAMERA MOVE THIS FRAME?
    //
    // Needed to read a zero velocity correctly, and that turns out to matter a
    // great deal. Our velocity attachment is CLEARED to zero and written only by
    // the vertex shaders we patched. Clouds never write it - cloud_render_raster
    // outputs data_out0/data_out1 and cloud_render_compute writes
    // img_output_cloud_t / img_output_depth_t, all dedicated cloud targets - and
    // neither does the sky. So at those pixels the field holds zero because
    // NOTHING WROTE THERE, not because the pixel is stationary.
    //
    // Those two cases are indistinguishable per-pixel and need opposite
    // treatment: a genuinely static pixel wants full accumulation, an unwritten
    // one cannot be reprojected at all. One bit from the camera separates them.
    // With the camera still, zero means static and history is perfect; with the
    // camera moving, zero means unknown.
    float edB;
    // ---- LOOK AT IT, AND REMOVE ONE INPUT AT A TIME.
    //
    // All live-editable while the sim runs. One picture settled what twenty
    // statistics could not when the velocity field was in doubt, and the cost of
    // that lesson was roughly twenty relaunches - so the ability to draw the
    // intermediate quantities, and to switch between them without restarting, is
    // not a convenience here. It is the method.
    int   viz;
    float vizScale;
    float gain;         // how hard a rejected sample pushes alpha toward 1
    float varClip;      // variance box half-width, in standard deviations
    int   flags;
    // ---- THE CONVENTION, FALSIFIABLE AT LAST.
    //
    // The Y sign and the overall scale of the reprojection offset have been
    // constants reasoned from the negative-viewport analysis - and a wrong sign
    // or scale survives every test run so far: the field LOOKS right in the
    // magnitude view (shape and smoothness carry no sign), and the stop test
    // passes (zero is zero under any convention). What a wrong convention DOES
    // produce is exactly the reported artifact: history fetched near-but-not-at
    // the right spot every frame of motion, edges doubling, texture smearing,
    // none of it while still. So both are live knobs now, and one orbit of the
    // camera per combination replaces an afternoon of reasoning about them.
    float velScale;     // multiplies the fetched vector; 1.0 = shipping belief
    float velYSign;     // -1.0 = shipping belief (negative viewport), +1.0 = flipped
    // 1 when uFlags is X-Plane's real gbuffer_vel; 0 when it is the fallback.
    int   flagsValid;
    float sMulX;        // S.x = sMulX * jitter.x
    float sMulY;        // S.y = sMulY * jitter.y
    float velMax;       // largest believable |velocity| in UV
    float novecCov;     // coverage below this = unwritten; <0 disables
    float novecAlpha;   // blend weight for pixels with no vector
    float movedDead;    // deadband on the clamp correction, in units of floorS
    float alphaMoving;  // blend weight while the camera is moving
    float alphaMovingPx;// px/frame at which alphaMoving is fully applied
    // ---- HOW MUCH OF THE UNJITTER'S SOFTNESS TO PUT BACK.
    //
    // 0 disables the pass entirely - not "sharpen by zero", the branch is
    // taken and the taps are never fetched. See sharpenCurrent.
    float sharpen;
    // ---- HOW HARD THE REACTIVE MASK PUSHES. 1.0 IS ALL-OR-NOTHING.
    //
    // The mask exists to stop transparent geometry reprojecting what is behind
    // it, and pinning the weight to 1.0 does that - but 1.0 also means those
    // pixels NEVER accumulate, so they never antialias either. On glass that is
    // the right trade. On water it is not: water is alpha-blended too, so the
    // mask catches it, and X-Plane's sun glitter on the waves is exactly the
    // high-frequency content temporal accumulation existed to average. Hard-on,
    // the glitter shows raw every frame and reads as dense stipple.
    //
    // A weight between the base alpha and 1.0 keeps the anti-smear property -
    // history is trusted much less than normal - while still letting the
    // surface converge. 1.0 reproduces the binary behaviour exactly.
    float reactiveAlpha;
    // Ambient occlusion. Must stay in this order and at this position to mirror
    // TaaPush: sharpen, reactiveAlpha, aoStrength, aoRadius.
    float aoStrength;   // 0 = off, and the shader takes no taps at all
    float aoRadius;     // radius in pixels at render resolution
    // Contact shadows. sunView is a unit vector toward the sun in VIEW space,
    // computed by the plugin; all zero means it is below the horizon.
    float sunViewX, sunViewY, sunViewZ;
    float csStrength;   // 0 = off
} pc;

const int FLAG_FREEZE_HISTORY = 1;
const int FLAG_NO_MOTION      = 2;
const int FLAG_NO_ACCUM       = 4;
const int FLAG_REACTIVE       = 8;   // consume the coverage mask in .a
const int FLAG_NO_UNJITTER    = 16;
const int FLAG_CATMULL        = 32;  // sharp history resampling; see the
                                     // note at sampleHistory
const int FLAG_RESET          = 512;  // was the int32 pc.reset
const int FLAG_CAMERA_MOVED   = 1024; // was the int32 pc.cameraMoved
const int FLAG_ENGINE_DEPTH   = 2048; // binding 5 holds X-Plane's own depth
const int FLAG_DEPTH_REPROJECT = 4096; // reconstruct velocity at unwritten px
// view distance from engine depth; fb is the injected clip-w fallback so a
// wrong identification degrades to exactly the previous behaviour.
// Velocity reconstructed from engine depth + camera motion, in EXACTLY the
// injection's convention: mv = (curr.xy/curr.w - prev.xy/prev.w) * 0.5, NDC
// units, unscaled (the caller applies pc.velScale like any written vector).
// Right for everything static, which is precisely the population of pixels
// that has no written vector: sky, clouds, terrain drawn by unpatched shaders.
// Moving objects our injection missed still reproject as if static - coarse,
// but strictly better than the zero they carried before.
vec2 mvReconstructVel(vec2 u, float lay)
{
    float d = texture(uEngineDepth, vec3(u, lay)).r;
    // Framebuffer UV to NDC. The Y sign comes from the viewport the layer
    // actually saw, not from an assumption - same rule as the jitter push.
    vec2 ndc = vec2(u.x * 2.0 - 1.0, uReprojParams.x * (u.y * 2.0 - 1.0));
    vec4 curr = vec4(ndc, d, 1.0);
    vec4 prev = uReproj * curr;
    if (abs(prev.w) < 1e-9) return vec2(0.0);
    return (curr.xy - prev.xy / prev.w) * 0.5;
}

float mvViewDepth(vec2 u, float lay, float fb)
{
    if ((pc.flags & FLAG_ENGINE_DEPTH) == 0) return fb;
    float d   = texture(uEngineDepth, vec3(u, lay)).r;
    float den = d + pc.edA;
    if (abs(den) < 1e-7) return fb;          // at-infinity texel
    float v = -pc.edB / den;
    return (v > 0.0) ? v : fb;
}
const int FLAG_DILATE         = 256; // borrow the closest neighbour's vector
                                     // at silhouettes; see the search above the
                                     // velocity fetch. Off makes every edge take
                                     // the texel-centre sample again, which is
                                     // the A/B for judging it.
const int FLAG_NOVEC_BY_VEL   = 64;  // legacy: pick unwritten pixels by
                                     // vel==0 instead of by coverage  // sample the raster raw - isolation only
const int FLAG_CR_UNJITTER    = 128; // fetch the CURRENT frame's unjittered
                                     // sample with Catmull-Rom instead of
                                     // bilinear; see sampleSceneCR

const int VIZ_OFF       = 0;
const int VIZ_MOTION    = 1;   // direction as colour
const int VIZ_MAGNITUDE = 2;   // speed as a heatmap
const int VIZ_INVALID   = 3;   // which pixels were rejected, and why
const int VIZ_HISTORY   = 4;   // the history buffer itself
const int VIZ_WEIGHT    = 5;   // the blend weight actually used
const int VIZ_CLAMP     = 6;   // how far the clamp moved history, in sigma
const int VIZ_WRITTEN   = 8;   // did ANY shader write velocity here - WHITE
                               // yes, BLACK no. Ungated by every other
                               // setting, deliberately: VIZ_MOTION zeroes the
                               // unwritten sentinel, so "nothing wrote here"
                               // and "the vector is zero" draw identically and
                               // a uniform-zero field is consistent with BOTH.
                               // This is the only view that separates them, and
                               // it is what showed the ground was black.

// A perceptually ordered ramp for the scalar views: black -> blue -> green ->
// yellow -> red. Ordered so that "more" always reads as "hotter" without a
// legend, and so that zero is unambiguously black rather than dark blue - the
// distinction between "no motion" and "a little motion" is exactly the one these
// views exist to make.
vec3 heat(float t)
{
    t = clamp(t, 0.0, 1.0);
    vec3 c;
    if      (t < 0.25) c = mix(vec3(0,0,0),   vec3(0,0,1),   t / 0.25);
    else if (t < 0.50) c = mix(vec3(0,0,1),   vec3(0,1,0),  (t - 0.25) / 0.25);
    else if (t < 0.75) c = mix(vec3(0,1,0),   vec3(1,1,0),  (t - 0.50) / 0.25);
    else               c = mix(vec3(1,1,0),   vec3(1,0,0),  (t - 0.75) / 0.25);
    return c;
}

const int MODE_PASSTHROUGH = 0;
const int MODE_REPROJECT   = 1;
const int MODE_FULL        = 2;
// ---- MODE 3: A CLEAN ROOM. TEXTBOOK TAA, NOTHING ELSE.
//
// Written because debugging MODE_FULL stopped converging. It carries a
// variance-normalised rejection metric, a reactive mask keyed on a coverage
// channel opaque geometry does not write, an unjitter step, a gain that drives
// the weight to 1 on flat ground, and several years of layered corrections -
// and the measured result is that TAA makes a STATIC image 4x less stable than
// no TAA even with reprojection disabled entirely, which is a statement about
// the accumulation and not about any of those knobs.
//
// This path shares only the inputs. It does what every TAA does and no more:
// fetch history along the motion vector, clamp it to the colour range its own
// neighbourhood spans this frame, blend at a fixed weight, store. No gain, no
// sigma, no reactive term, no unjitter, no tonemap round trip. If THIS is
// unstable on a still camera, the fault is in the plumbing around the resolve -
// the history binding or the copy back - and not in any resolve logic, which is
// a different search and a much shorter one.
const int MODE_CLEAN       = 3;
// ---- MODE 4: RCAS-STYLE SHARPEN, RUN AS A SEPARATE PASS AFTER THE RESOLVE.
//
// TAA is a low-pass filter: every history fetch is a resample, and at a low
// alpha a sample is resampled for as many frames as it survives, so fine
// detail - panel text, runway paint, instrument glass - is averaged away. The
// fix every shipping TAA uses is a sharpening pass, NOT a shorter history
// (which just trades the blur for aliasing).
//
// The trap is where it runs. Folding a sharpen into the resolve writes the
// boosted value into the very buffer next frame samples as history, so the
// boost compounds every frame into runaway grain - measured, and the reason an
// earlier attempt was reverted. This mode instead reads the ALREADY-resolved
// image and writes to a DEDICATED target that only the copy-to-screen consumes.
// The accumulation history stays pristine; only the displayed copy is
// sharpened, so nothing feeds back.
const int MODE_SHARPEN     = 4;

// RGB to YCoCg. The neighbourhood clamp is done in YCoCg because clamping in
// RGB clips hue as well as luminance, which is what turns a rejected sample
// into a coloured speckle rather than a slightly wrong grey.
vec3 rgb2ycocg(vec3 c)
{
    return vec3( 0.25 * c.r + 0.5 * c.g + 0.25 * c.b,
                 0.5  * c.r             - 0.5  * c.b,
                -0.25 * c.r + 0.5 * c.g - 0.25 * c.b);
}

vec3 ycocg2rgb(vec3 c)
{
    return vec3(c.x + c.y - c.z,
                c.x        + c.z,
                c.x - c.y - c.z);
}

// ---- WEIGHT IN TONEMAPPED SPACE, NOT RAW HDR.
//
// The scene is HDR: a specular highlight can be fifty times the neighbourhood
// mean. Computing the variance box on those values makes sigma enormous, so the
// clamp barely constrains history and bright areas keep smearing - which reads
// as a glare that grows as you move. It also lets the clamped YCoCg value
// invert back to NEGATIVE rgb, which appears as black dots along high-contrast
// edges exactly when the camera moves.
//
// tm is applied so that every STATISTIC below is computed on values of
// comparable size - a highlight counts once rather than fifty times. What it is
// NOT used for is producing the output colour; see the note on the missing
// inverse directly beneath.
float luma(vec3 c) { return dot(c, vec3(0.2126, 0.7152, 0.0722)); }
vec3  tm(vec3 c)   { return c / (1.0 + luma(c)); }

// THERE IS DELIBERATELY NO INVERSE HERE.
//
// A previous version had one, and it is what turned the screen white and then
// black. The inverse of tm is c / (1 - luma(c)), which is exact only for values
// that really are tonemapped, where luma < 1 by construction. A value that has
// been clamped PER CHANNEL in YCoCg does not satisfy that - per-channel
// clamping can leave the RGB hull - so luma reaches 1, the epsilon floor
// engages, and the pixel is multiplied by ten thousand.
//
// Guarding the epsilon caps how large the wrong answer gets; it does not make
// the answer right. So tm is used only where its output is CONSUMED as a
// statistic - the mean, the variance, the box, and the weight derived from them
// - and every colour that reaches the output stays linear the whole way. See
// the weight computation in main().

// ---- WHY HISTORY IS NOT FETCHED WITH texture().
//
// MEASURED, and by the only instrument that could tell: the smear appears
// ONLY under camera movement, is absent with the camera parked, and is stuck
// to the ground surface rather than to the screen. Nothing about WHICH texel
// history comes from explains that - the vectors were checked against image
// flow and are right, and scale, clamp width and blend weight were each swept
// with no effect on it.
//
// The filter explains it exactly. history is fetched at uv + vel, a
// NON-INTEGER offset, through a VK_FILTER_LINEAR sampler. Bilinear is a
// low-pass filter, so every fetch softens history a little; at alpha 0.05 a
// sample survives about twenty frames and is therefore resampled about twenty
// times, each pass compounding the last. Parked, vel is zero, the offset is
// zero, the filter is an identity and the image stays sharp. Moving, the
// offset is non-zero every frame, the blur compounds, and because it rides the
// reprojection it is painted onto the surface. That is the whole symptom.
//
// Catmull-Rom is the standard answer: a bicubic with negative lobes, so it
// preserves the frequencies bilinear removes rather than merely redistributing
// them. Nine taps arranged as bilinear-assisted pairs, which is the usual
// 3x3-from-5-fetches trick generalised - the cost is taps, not bandwidth.
//
// The negative lobes can ring into negative values on a high-contrast edge.
// The caller already floors the stored result at zero, and the clamp box
// bounds it besides, so ringing cannot survive into history.
vec3 sampleHistory(vec2 uv, float layer, vec2 tsz)
{
    if ((pc.flags & FLAG_CATMULL) == 0)
        return texture(uHistorySampler, vec3(uv, layer)).rgb;

    vec2 samplePos = uv * tsz;
    vec2 texPos1   = floor(samplePos - 0.5) + 0.5;
    vec2 f         = samplePos - texPos1;

    vec2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
    vec2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);
    vec2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));
    vec2 w3 = f * f * (-0.5 + 0.5 * f);

    vec2 w12      = w1 + w2;
    vec2 offset12 = w2 / max(w12, vec2(1e-6));

    vec2 p0  = (texPos1 - 1.0)      / tsz;
    vec2 p3  = (texPos1 + 2.0)      / tsz;
    vec2 p12 = (texPos1 + offset12) / tsz;

    vec3 r = vec3(0.0);
    r += texture(uHistorySampler, vec3(p0.x,  p0.y,  layer)).rgb * (w0.x  * w0.y);
    r += texture(uHistorySampler, vec3(p12.x, p0.y,  layer)).rgb * (w12.x * w0.y);
    r += texture(uHistorySampler, vec3(p3.x,  p0.y,  layer)).rgb * (w3.x  * w0.y);

    r += texture(uHistorySampler, vec3(p0.x,  p12.y, layer)).rgb * (w0.x  * w12.y);
    r += texture(uHistorySampler, vec3(p12.x, p12.y, layer)).rgb * (w12.x * w12.y);
    r += texture(uHistorySampler, vec3(p3.x,  p12.y, layer)).rgb * (w3.x  * w12.y);

    r += texture(uHistorySampler, vec3(p0.x,  p3.y,  layer)).rgb * (w0.x  * w3.y);
    r += texture(uHistorySampler, vec3(p12.x, p3.y,  layer)).rgb * (w12.x * w3.y);
    r += texture(uHistorySampler, vec3(p3.x,  p3.y,  layer)).rgb * (w3.x  * w3.y);

    return max(r, vec3(0.0));
}

// ---- THE OTHER BILINEAR FETCH, WHICH WENT UNCOUNTED.
//
// The note above indicts bilinear for softening HISTORY, and fixes it. It
// leaves the identical fetch on the CURRENT frame alone, on the argument
// recorded at the callsite: "Bilinear, so it costs half a texel of softness at
// most." That accounting is wrong in two ways.
//
// First, the offset is not incidental. The unjitter fetch is at uv + S with S
// a sub-texel jitter that is DELIBERATELY non-zero and DELIBERATELY different
// every frame - so unlike the history fetch, which is an identity while parked,
// this one is a low-pass filter on EVERY frame including a parked one. That is
// why TAA reads as softer than TAA-off even with the camera stopped, which no
// amount of history tuning could ever explain.
//
// Second, "at most half a texel" is the per-frame figure and the loss does not
// stay per-frame. currA is what history accumulates; at alpha 0.05 the steady
// state is a running mean of twenty already-softened samples, so the filter is
// baked into the converged image rather than averaged out of it.
//
// The fix is the fix that already worked once: a bicubic with negative lobes
// resamples by a sub-texel offset while preserving the frequencies bilinear
// removes. Same nine taps, same weights, against uScene instead of the history.
//
// GLSL will not let the sampler be a parameter without duplicating the call
// site conditions, so this is sampleHistory's body with one binding changed.
// The duplication is deliberate: the two have different failure modes and
// merging them would put a branch in the inner loop of both.
vec3 sampleSceneCR(vec2 uv, float layer, vec2 tsz)
{
    vec2 samplePos = uv * tsz;
    vec2 texPos1   = floor(samplePos - 0.5) + 0.5;
    vec2 f         = samplePos - texPos1;

    vec2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
    vec2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);
    vec2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));
    vec2 w3 = f * f * (-0.5 + 0.5 * f);

    vec2 w12      = w1 + w2;
    vec2 offset12 = w2 / max(w12, vec2(1e-6));

    vec2 p0  = (texPos1 - 1.0)      / tsz;
    vec2 p3  = (texPos1 + 2.0)      / tsz;
    vec2 p12 = (texPos1 + offset12) / tsz;

    vec3 r = vec3(0.0);
    r += texture(uScene, vec3(p0.x,  p0.y,  layer)).rgb * (w0.x  * w0.y);
    r += texture(uScene, vec3(p12.x, p0.y,  layer)).rgb * (w12.x * w0.y);
    r += texture(uScene, vec3(p3.x,  p0.y,  layer)).rgb * (w3.x  * w0.y);

    r += texture(uScene, vec3(p0.x,  p12.y, layer)).rgb * (w0.x  * w12.y);
    r += texture(uScene, vec3(p12.x, p12.y, layer)).rgb * (w12.x * w12.y);
    r += texture(uScene, vec3(p3.x,  p12.y, layer)).rgb * (w3.x  * w12.y);

    r += texture(uScene, vec3(p0.x,  p3.y,  layer)).rgb * (w0.x  * w3.y);
    r += texture(uScene, vec3(p12.x, p3.y,  layer)).rgb * (w12.x * w3.y);
    r += texture(uScene, vec3(p3.x,  p3.y,  layer)).rgb * (w3.x  * w3.y);

    return max(r, vec3(0.0));
}

// ---- SHARPENING BELONGS ON THE CURRENT SAMPLE, NOT ON THE OUTPUT.
//
// This dispatch writes ONE image, uHistory, and the layer copies that into the
// scene target with vkCmdCopyImage - there is no shader stage between history
// and the screen to sharpen in. So the choice is to sharpen what goes INTO
// history or nothing at all, and the two are not equivalent:
//
//   sharpening the STORED result compounds. Frame N sharpens a value that was
//   already sharpened on frame N-1, N-2, ... and at alpha 0.05 that is twenty
//   applications of the kernel. It ends in ringing and haloing that no strength
//   setting avoids, because the strength multiplies twenty times over.
//
//   sharpening the CURRENT SAMPLE does not. out = mix(hist, sharp(curr), a) has
//   the steady state sharp(curr) filtered temporally - the kernel is applied
//   exactly once to each sample, and history is a mean of singly-sharpened
//   values. This is the same place UE's accumulation filter puts its sharpen,
//   and for the same reason.
//
// The kernel is a five-tap cross unsharp, and the result is CLAMPED to the span
// of the taps that formed it. That clamp is what separates this from a naive
// unsharp mask: the negative lobe cannot overshoot past the darkest neighbour
// or undershoot past the brightest, so a high-contrast edge gains contrast
// without gaining a halo, and a firefly cannot be manufactured out of a
// gradient. It is RCAS' limiter, arrived at the same way and for the same
// reason - and it is why the strength can be opened up without the image
// falling apart.
//
// The taps are taken at uv, i.e. at the ALREADY-UNJITTERED position, so this
// measures the local contrast of the geometry rather than of the jitter.
vec3 sharpenCurrent(vec3 c, vec2 uv, float layer, vec2 invSz)
{
    vec3 l = texture(uScene, vec3(uv - vec2(invSz.x, 0.0), layer)).rgb;
    vec3 r = texture(uScene, vec3(uv + vec2(invSz.x, 0.0), layer)).rgb;
    vec3 u = texture(uScene, vec3(uv - vec2(0.0, invSz.y), layer)).rgb;
    vec3 d = texture(uScene, vec3(uv + vec2(0.0, invSz.y), layer)).rgb;

    vec3 blur = (l + r + u + d) * 0.25;
    vec3 s    = c + (c - blur) * pc.sharpen;

    // The limiter. min/max over the cross INCLUDING the centre, so a pixel that
    // is already the local extreme is free to keep its value and everything
    // else is bounded by real neighbouring colour.
    vec3 lo = min(min(min(l, r), min(u, d)), c);
    vec3 hi = max(max(max(l, r), max(u, d)), c);
    return clamp(s, lo, hi);
}

void main()
{
    ivec2 px    = ivec2(gl_GlobalInvocationID.xy);
    int   layer = int(gl_GlobalInvocationID.z);
    // textureSize on an array returns (w, h, layers).
    ivec3 size3 = textureSize(uScene, 0);
    ivec2 size  = size3.xy;
    if (px.x >= size.x || px.y >= size.y || layer >= size3.z) return;

    // ---- MODE 4: the sharpen pass. See the note at MODE_SHARPEN.
    //
    // Reads the resolved image through uHistorySampler (bound here to the buffer
    // the resolve just wrote) and writes a sharpened copy to uHistory (bound
    // here to the throwaway sharpen target, NOT the accumulation history). A
    // 5-tap cross unsharp mask - centre plus its four axial neighbours - clamped
    // to the local per-channel min/max so it can lift edge contrast but never
    // overshoot past colours already present, which is what keeps it from
    // ringing or manufacturing grain. Flat regions have a zero Laplacian and are
    // returned unchanged. Neighbour taps are clamped to the image so the border
    // reads no garbage.
    if (pc.mode == MODE_SHARPEN) {
        ivec2 hi2 = size - 1;
        vec3 e  = texelFetch(uHistorySampler, ivec3(px, layer), 0).rgb;
        vec3 up = texelFetch(uHistorySampler,
                    ivec3(clamp(px + ivec2(0, -1), ivec2(0), hi2), layer), 0).rgb;
        vec3 dn = texelFetch(uHistorySampler,
                    ivec3(clamp(px + ivec2(0,  1), ivec2(0), hi2), layer), 0).rgb;
        vec3 lf = texelFetch(uHistorySampler,
                    ivec3(clamp(px + ivec2(-1, 0), ivec2(0), hi2), layer), 0).rgb;
        vec3 rt = texelFetch(uHistorySampler,
                    ivec3(clamp(px + ivec2( 1, 0), ivec2(0), hi2), layer), 0).rgb;
        vec3 lo = min(e, min(min(up, dn), min(lf, rt)));
        vec3 hi = max(e, max(max(up, dn), max(lf, rt)));
        // ---- SHARPEN WHAT HAS CONVERGED, NOT WHAT JUST ARRIVED.
        //
        // This applied the same strength to every pixel. A disoccluded one -
        // freshly revealed, no history behind it, still noisy - was sharpened
        // exactly as hard as a pixel that had been accumulating for a hundred
        // frames. Sharpening amplifies whatever is there, so on a trail of
        // fresh pixels it amplifies the difference between neighbouring frames:
        // that is the crawl along disocclusion edges.
        //
        // Two gates, both from data already to hand:
        //
        // CONFIDENCE - the resolve now leaves its blend weight in history alpha.
        // 0 is fully accumulated, 1 is raw current frame. (1 - a) is therefore
        // how much of this pixel is real history, and is exactly how much of it
        // is worth sharpening.
        //
        // MOTION - a fast-moving pixel is reconstructed from fewer usable
        // samples and is the least stable thing on screen. Sharpening it makes
        // motion crawl. Faded out over ~8 px/frame, which is gentle enough not
        // to visibly switch off on a slow pan.
        float conf = 1.0 - clamp(texelFetch(uHistorySampler, ivec3(px, layer), 0).a,
                                 0.0, 1.0);
        // ---- NO MOTION TERM. IT WAS A MISTAKE.
        //
        // This also faded sharpening out with velocity, over ~8 px/frame. That
        // sounded reasonable and is wrong in a cockpit: panning the view moves
        // panel pixels well past 8 px/frame, so sharpening switched off exactly
        // when the camera moved and the panel text went soft on every head
        // turn. The reported symptom was 'text gets blurry when I move', and
        // it was this line.
        //
        // The defect being fixed was that sharpen could not tell a converged
        // pixel from a freshly disoccluded one. Confidence answers that. Motion
        // is a different question and did not need answering.
        float amt  = pc.sharpen * conf;
        vec3 sharp = e + amt * (4.0 * e - up - dn - lf - rt);
        sharp = clamp(sharp, lo, hi);
        imageStore(uHistory, ivec3(px, layer), vec4(max(sharp, vec3(0.0)), 1.0));
        return;
    }

    vec3 curr = texelFetch(uScene, ivec3(px, layer), 0).rgb;

    // ---- STAGE 0: prove the plumbing, compute nothing.
    //
    // Every binding is declared and the dispatch covers the whole image, but
    // the output is the input. If the frame changes at all in this mode the
    // fault is in the wiring - the wrong image bound, a bad barrier, a layout
    // mismatch, the dispatch size - and not in any of the maths below.
    if (pc.mode == MODE_PASSTHROUGH) {
        imageStore(uHistory, ivec3(px, layer), vec4(curr, 1.0));
        return;
    }

    vec2 uv = (vec2(px) + 0.5) * pc.invSize;

    // ---- UNJITTER: read the raster where the geometry actually is.
    //
    // pc.jitter is the NDC offset the vertex splice ADDED this frame - the
    // applied value, not the plugin's request, so scale and Y sign are already
    // in it. The whole raster is displaced by it: colour, velocity and
    // coverage all live at uv + S, while history is stored unjittered (it
    // converges to the mean of the offsets). Fetching current AT uv therefore
    // blends a displaced sample into a stable history, which drags alpha's
    // worth of the displacement into the output every frame - and that is the
    // whole image visibly shaking. Jitter is only invisible when the resolve
    // that consumes it cancels it; this is the cancellation.
    //
    // NDC to UV: uv_x = 0.5 + 0.5*ndc_x but uv_y = 0.5 - 0.5*ndc_y, because
    // the viewport height is negative - the same sign the velocity fetch
    // below already carries.
    // ---- THE SIGN, MEASURED RATHER THAN REASONED.
    //
    // Halving taa.jitter_scale left the shake unchanged in amplitude. An error
    // that does not scale with the offset is not a magnitude mistake, it is a
    // direction one: with the wrong sign the fetch moves AWAY from where the
    // raster was displaced, so the sample lands two jitters from the geometry
    // instead of on it, and doubling the displacement of a value that already
    // changes every frame looks identical at any amplitude - which is exactly
    // what the half-amplitude test showed.
    //
    // The raster was displaced by +jitter, so the geometry that belongs at uv
    // now sits at uv MINUS that displacement in UV units. The Y term keeps its
    // negation because the layer pushes NDC and the viewport height is
    // negative; only the overall direction changes.
    vec2 S = (pc.flags & FLAG_NO_UNJITTER) != 0
           ? vec2(0.0)
           : vec2(pc.sMulX * pc.jitter.x, pc.sMulY * pc.jitter.y);

    // ---- THE STORED VALUE IS ALREADY A UV OFFSET.
    //
    // The field holds (prevNDC - currNDC) * 0.5. Since uv = ndc * 0.5 + 0.5,
    // that 0.5 IS the NDC-to-UV conversion - it is not a factor to undo. An
    // earlier version multiplied by 2 and fetched history twice as far as it
    // should, which showed up as horizontal streaking across the whole frame.
    //
    // Y is negated because X-Plane renders with a NEGATIVE viewport height, so
    // ndc_y = +1 is at the TOP and uv_y = 0.5 - 0.5 * ndc_y. That makes
    // d(uv_y) = -vel_y while d(uv_x) = +vel_x. The same sign that took the
    // field's own diagnostic from 4.8 px to 0.0015 px applies here.
    // ---- VELOCITY DILATION: BORROW THE CLOSEST NEIGHBOUR'S VECTOR.
    //
    // A silhouette pixel is a blend of foreground and background, but it gets
    // ONE velocity - whichever surface happened to win the texel centre. On a
    // gear strut, an antenna, a wire or a pylon edge that is usually the
    // BACKGROUND, so the edge is reprojected as though it were the sky behind
    // it and drags a ghost every frame the camera moves. Thin geometry is
    // exactly where this is most visible and exactly where the centre sample is
    // least likely to be right.
    //
    // The fix every TAA implementation uses: search the 3x3 and take the vector
    // of the CLOSEST fragment, so an edge follows the object in front rather
    // than the void behind. Depth comes from B (clip w, written by the injector)
    // because this shader has no depth binding.
    //
    // Unwritten texels are skipped by the R sentinel, never by depth - their B
    // is a cleared zero, which would otherwise read as nearer than everything
    // real and win every comparison.
    vec2 dilate = vec2(0.0);
    if ((pc.flags & FLAG_DILATE) != 0) {
        vec2 dtsz = 1.0 / vec2(size);
        float bestW = 1.0e30;
        for (int dy = -1; dy <= 1; ++dy)
            for (int dx = -1; dx <= 1; ++dx) {
                vec2 o = vec2(dx, dy) * dtsz;
                vec4 n = texture(uVelocity, vec3(uv + S + o, float(layer)));
                if (n.x < -1000.0 || n.y < -1000.0) continue;  // nothing wrote
                if (n.z > 0.0 && n.z < bestW) { bestW = n.z; dilate = o; }
            }
    }
    vec4 velS = texture(uVelocity, vec3(uv + S + dilate, float(layer)));
    // The target is cleared to a sentinel, so "nobody wrote here" is a fact
    // rather than an inference from a zero vector. Bilinear filtering can blend
    // a sentinel texel with a real one, so the test is a threshold well below
    // any reachable velocity and well above the sentinel.
    bool unwritten = velS.x < -1000.0 || velS.y < -1000.0;
    vec2 vel  = unwritten ? vec2(0.0) : velS.xy * pc.velScale;
    // ---- AN UNWRITTEN PIXEL IS NO LONGER AN UNREADABLE ONE.
    //
    // vel = 0 at an unwritten pixel was the resolve's oldest dilemma: with the
    // camera moving, zero is simply WRONG for everything static, and the whole
    // novec/cameraMoved machinery below exists to manage how wrong. With the
    // engine's depth bound, the camera-motion component is computable exactly
    // - so compute it. The pixel keeps its unwritten status for every other
    // decision (coverage, alpha, AO gates); only the vector stops being a lie.
    bool reconstructed = false;
    if (unwritten && (pc.flags & FLAG_DEPTH_REPROJECT) != 0 &&
        uReprojParams.y > 0.5) {
        vel = mvReconstructVel(uv + S, float(layer)) * pc.velScale;
        reconstructed = true;
    }
    // ---- THE COVERAGE MASK (C13 -> C14).
    //
    // The velocity target is RGBA16F and its alpha carries the transparency
    // gate the fragment patcher writes: 1 where opaque geometry owns the
    // pixel, 0 where nothing drew or only transparent texels landed - the sky,
    // and the propeller's blur disc. Those pixels flicker by construction
    // (animated transparency alternates blade and background every frame), and
    // accumulating a flicker is the prop halo and its ground trail. Coverage
    // below half forces the weight to the current frame further down.
    float cov = velS.w;

    // ---- COVERAGE IS A REGION PROPERTY, NOT A PIXEL PROPERTY.
    //
    // With jitter armed, a silhouette pixel's coverage flips above and below
    // one half every frame - the sub-pixel offset moves the edge across the
    // sample point, which is the entire point of jittering. Firing the
    // reactive mask on the CENTRE sample therefore set a=1.0 along every edge
    // in the scene, every frame, and every edge refreshed as raw jittered
    // current: the reported whole-scene shake. The prop disc - the thing the
    // mask exists for - is transparent across a REGION, not along a line, so
    // the mask now fires on the neighbourhood maximum: an edge pixel has an
    // opaque neighbour and stays temporal, the disc interior has none and
    // takes the current frame.
    // ---- AND THIS NEIGHBOURHOOD HAS TO BE READ WHERE THE RASTER IS, TOO.
    //
    // The note above identifies the mechanism exactly, and the neighbourhood
    // maximum is the right mitigation - but it was gathered with texelFetch at
    // integer pixels while the centre coverage is read at uv + S, the jittered
    // position. So the mask still compared a jittered centre against an
    // unjittered neighbourhood, still flipped along every silhouette as the
    // offset moved the edge across the sample point, and still refreshed those
    // pixels as raw current every frame. A mask that fires takes the jittered
    // frame whole, which is why the resulting shake never scaled with the
    // jitter amplitude: it is a threshold flipping, not a displacement.
    // ---- NINE FETCHES FOR A CONSUMER THAT SHIPS DISABLED.
    //
    // Both readers of covMax (the disocclusion term below and the reactive
    // override near the end) test FLAG_REACTIVE themselves, and the mask ships
    // off - so this ran nine texture fetches per pixel per frame to produce a
    // value nothing was allowed to use. Left at 0.0 when the flag is clear,
    // which is what both tests already fall through on, so the picture is
    // bit-identical and the work is simply not done.
    float covMax = 0.0;
    if ((pc.flags & FLAG_REACTIVE) != 0) {
        vec2 ctsz = 1.0 / vec2(size);
        for (int cy = -1; cy <= 1; ++cy)
            for (int cx = -1; cx <= 1; ++cx)
                covMax = max(covMax, texture(uVelocity,
                    vec3(uv + S + vec2(cx, cy) * ctsz, float(layer))).w);
    }
    // ---- REJECT A VECTOR THAT IS NOT A NUMBER.
    //
    // MEASURED: with velocity live, alpha does NOTHING - 1.0 and 0.01 give the
    // same temporal deviation (6.2 vs 6.6), which is only possible if history
    // is never retained. Forcing vel to zero restores it exactly as theory
    // says it should (0.98 at alpha 0.05, 0.44 at 0.01). But SCALING velocity
    // to zero does NOT (5.94), and the only quantity that survives a multiply
    // by zero is NaN or infinity.
    //
    // A NaN hUv is worse than an out-of-range one, because every comparison
    // against NaN is FALSE: the bounds test below reads "in range", the fetch
    // returns undefined, and the neighbourhood clamp then drags that undefined
    // value into the current frame's colour range - so the frame looks
    // plausible while carrying no history at all. That is the whole failure:
    // no antialiasing, and shake that tracks the jitter exactly.
    //
    // Written as a NEGATED in-range test so NaN fails it: NaN < 1.0 is false,
    // so !(false) is true and the vector is discarded. One texel of motion is
    // already far more than any real frame produces at this resolution.
    if (!(abs(vel.x) < pc.velMax) || !(abs(vel.y) < pc.velMax)) vel = vec2(0.0);
    if ((pc.flags & FLAG_NO_MOTION) != 0) vel = vec2(0.0);
    vec2 hUv  = uv + vec2(vel.x, pc.velYSign * vel.y);

    // ---- THE VIEWS THAT DO NOT DEPEND ON HISTORY.
    //
    // Drawn before any rejection so they describe the FIELD rather than what
    // survived the tests below - which is the whole point of looking at it.
    if (pc.viz == VIZ_MOTION) {
        // Vectors in PIXELS, then to colour around a grey zero. Sky and cloud
        // should be flat grey: they have no vectors, and if they are not grey
        // something wrote there that should not have.
        // Through the SAME convention the fetch uses, or the picture and the
        // consumer can disagree in sign - an instrument must show what is
        // consumed, not what is stored.
        vec2 px2 = vec2(vel.x, pc.velYSign * vel.y) * vec2(size);
        vec3 c = vec3(0.5) + vec3(px2.x, px2.y, 0.0) * 0.02 * pc.vizScale;
        imageStore(uHistory, ivec3(px, layer), vec4(c, 1.0));
        return;
    }
    if (pc.viz == VIZ_WRITTEN) {
        // Keyed straight on the clear sentinel, so it reports the raw state of
        // the velocity target and nothing downstream of it.
        imageStore(uHistory, ivec3(px, layer),
                   unwritten ? vec4(0.0, 0.0, 0.0, 1.0)
                             : vec4(1.0, 1.0, 1.0, 1.0));
        return;
    }
    if (pc.viz == VIZ_MAGNITUDE) {
        // Log scale, because the interesting range spans 0.1 px at the horizon
        // to 60+ px underfoot and a linear ramp shows one or the other. Marks:
        // blue 1 px, green 4, yellow 16, red 64.
        float m = length(vel * vec2(size));
        imageStore(uHistory, ivec3(px, layer),
                   vec4(heat(log2(1.0 + m * pc.vizScale) / 6.0), 1.0));
        return;
    }

    // Off-screen history cannot be reprojected. Falling back to the current
    // frame is correct and visible as a thin band of aliasing at the leading
    // edge, which is the honest artifact - inventing a sample would smear.
    bool valid = all(greaterThanEqual(hUv, vec2(0.0))) &&
                 all(lessThanEqual(hUv, vec2(1.0)));

    // ---- CLOUDS AND SKY: NO VECTOR EXISTS, SO DO NOT REPROJECT.
    //
    // Three facts, each established separately from the shader corpus, and
    // together they say our filter cannot help these pixels and can hurt them:
    //
    //  1. No motion-vector texture exists in X-Plane. The only `vel`-named
    //     buffer is gbuffer_vel, in ssr_deferred alone, typed
    //     %uint 2D 0 1 1 1 and read twice as OpBitwiseAnd %uint_4 - it stores
    //     FLAGS. Object motion is a binary choice between two rigid matrices.
    //  2. Clouds never write the g-buffer, so any velocity sampled at a cloud
    //     pixel belongs to whatever opaque geometry, or sky default, is BEHIND
    //     the cloud. Reprojecting by it fetches an unrelated part of history.
    //  3. cloud_upscale is already a full TAA - two histories, analytic matrix
    //     reprojection, a four-test rejection and its own clamp - running at
    //     sub-resolution, and cloud pixels are deliberately re-noised every
    //     frame by u_cloud_temporal_jitter_t. What reaches us is already
    //     averaged and spatially stretched.
    //
    // So ghosting there is cloud_upscale's own history leaking through our
    // clamp, and no amount of tuning our clamp reaches it. Cloud pixels are also
    // two-valued in depth (Rg16f near and far) so there is not even one
    // unambiguous surface to attach a vector to. Declining is the correct
    // answer, not an approximation of one.
    //
    // The test is principled rather than a colour heuristic: an exactly-zero
    // vector while the camera is moving means no patched shader wrote this
    // pixel. That is precisely the set we cannot reproject - sky, clouds, and
    // any draw whose shader we failed to patch, which is the right set for all
    // three reasons.
    // ---- "EXACTLY ZERO" IS NOT THE SAME AS "NOBODY WROTE HERE".
    //
    // The reasoning above is right about WHICH pixels must be declined - sky,
    // clouds, unpatched draws - but the test picks them by vel == 0, and that
    // is only diagnostic while the camera is MOVING. It reads cameraMoved to
    // establish that, and cameraMoved is set by comparing the reprojection
    // matrix against identity at 1e-6: a still camera with a hair of numerical
    // noise reads as moving. Every correctly-written pixel of a stationary
    // world then holds exactly zero - the true answer - and the test calls the
    // WHOLE FRAME unwritten and throws its history away.
    //
    // MEASURED: that is the missing accumulation. Zeroing the velocity through
    // this test gives 0.733; zeroing it through FLAG_NO_MOTION, which skips the
    // test, gives 0.079 - a tenfold difference between two paths that produce
    // an identical vector. No alpha, clamp or jitter change can reach it,
    // which is why alpha never bit and why nothing antialiased.
    //
    // Coverage answers the actual question. The fragment patcher writes 1 into
    // alpha where opaque geometry owns the pixel and 0 where nothing drew, so
    // it separates "unwritten" from "written, and stationary" - which a zero
    // vector cannot do.
    bool noVector = (pc.flags & FLAG_NOVEC_BY_VEL) != 0
                  ? ((pc.flags & FLAG_CAMERA_MOVED) != 0 && vel == vec2(0.0)
                     && (pc.flags & FLAG_NO_MOTION) == 0)
                  : (pc.novecCov >= 0.0 && unwritten
                     && (pc.flags & FLAG_NO_MOTION) == 0);

    // ---- WHICH PIXELS WERE REJECTED, AND WHY.
    //
    // The single most useful view here, because it is the only one that can
    // falsify the cloud and sky rejection above. That test claims to select
    // exactly the pixels no patched shader wrote; this draws the set it actually
    // selected, so the claim can be checked by looking instead of argued about.
    //
    //   RED    no vector was written and the camera moved - sky, cloud, or a
    //          shader we failed to patch. Should cover the sky and the clouds
    //          and NOTHING ELSE. Red on terrain means a patching hole.
    //   BLUE   history reprojected off screen. Should be a thin band at the
    //          leading edge, thickening with speed.
    //   GREEN  accepted, reprojected, blended.
    if (pc.viz == VIZ_INVALID) {
        // YELLOW joins the classes: covered by transparent/animated content,
        // which the reactive mask hands to the current frame. The prop disc
        // should be a clean yellow circle; yellow over the whole airframe
        // would mean the gate is misreading opaque geometry.
        // MAGENTA: unwritten, but carrying a depth-reconstructed vector -
        // the set that used to be red. Red shrinking to magenta under camera
        // motion IS the feature working; red that stays red is a pixel the
        // reconstruction could not serve (invalid matrix, or harvest off).
        vec3 c = reconstructed ? vec3(1.0, 0.0, 1.0)
               : noVector    ? vec3(1.0, 0.0, 0.0)
               : !valid     ? vec3(0.0, 0.0, 1.0)
               : (covMax < 0.5 && (pc.flags & FLAG_REACTIVE) != 0)
                            ? vec3(1.0, 1.0, 0.0)
                            : vec3(0.0, 1.0, 0.0);
        imageStore(uHistory, ivec3(px, layer), vec4(c, 1.0));
        return;
    }

    // The aligned read of the current frame. Everything below that consumes
    // "the current frame" as a colour consumes this; the raster-space
    // statistics loop keeps its texelFetches because a box built from the
    // actual raster is still the right box, S being well under one texel.
    //
    // The filter is no longer bilinear by default - see sampleSceneCR for why
    // "half a texel of softness at most" was the wrong way to account for it.
    vec3 currA = (pc.flags & FLAG_CR_UNJITTER) != 0
               ? sampleSceneCR(uv + S, float(layer), vec2(size))
               : texture(uScene, vec3(uv + S, float(layer))).rgb;

    // Put back what the resample could not preserve. Applied here, to the
    // current sample, so it is applied exactly once per sample rather than
    // once per frame of history.
    if (pc.sharpen > 0.001)
        currA = sharpenCurrent(currA, uv + S, float(layer), pc.invSize);

    // ---- AMBIENT OCCLUSION, FROM THE DEPTH ALREADY IN THE VELOCITY TARGET.
    //
    // X-Plane ships SSAO, but it is spatial: a small sample budget re-drawn
    // every frame, so it is coarse and cannot resolve the small geometry a
    // cockpit is made of - switch bases, bezel edges, panel seams, the gap
    // under the glareshield. That scale of contact darkening is most of what
    // separates modelled from rendered.
    //
    // WHY THIS NEEDS NO NEW RESOURCES. Occlusion wants a depth buffer, and this
    // shader has none bound. It does not need one: the injector now writes clip
    // w into the velocity target's B channel (added for dilation), and clip w
    // IS view-space distance. So the depth is already here, in a texture
    // already bound, at no cost - no image, no view, no descriptor, no dispatch,
    // no barrier.
    //
    // WHY IT IS APPLIED TO currA AND NOT AFTERWARDS. Multiplying the CURRENT
    // frame means the occlusion goes through the same history blend as
    // everything else, so TAA accumulates it across frames for free. That is
    // the temporal denoise a separate AO pass would have had to build - a
    // rotated 8-tap pattern per frame converges to a far smoother result than 8
    // taps ever look on their own, which is exactly why a half-resolution pass
    // with its own history buffer was not worth its machinery.
    //
    // The radius is in PIXELS rather than metres. Converting a world radius
    // needs the projection, and there is no matrix in this push block; a fixed
    // screen radius is the standard approximation and behaves predictably.
    //
    // Sky and anything else nothing wrote is skipped by the sentinel - w there
    // is a cleared zero, which would read as infinitely near and blacken the
    // horizon.
    if (pc.aoStrength > 0.0 && !unwritten && velS.z > 0.0) {
        float w0 = mvViewDepth(uv + S, float(layer), velS.z);
        // Per-pixel rotation (interleaved gradient noise). Without it the eight
        // taps land on the same eight angles everywhere and the occlusion shows
        // its sampling pattern as a visible texture.
        float ign = fract(52.9829189 * fract(dot(vec2(px), vec2(0.06711056, 0.00583715))));
        float rot = ign * 6.2831853;
        const int   AO_TAPS = 8;
        float occ = 0.0;
        for (int i = 0; i < AO_TAPS; ++i) {
            float ang = rot + float(i) * (6.2831853 / float(AO_TAPS));
            // sqrt spacing spreads the taps evenly over the DISC rather than
            // bunching them at the centre.
            float rad = pc.aoRadius * sqrt((float(i) + 0.5) / float(AO_TAPS));
            vec2  o   = vec2(cos(ang), sin(ang)) * rad / vec2(size);
            float wn  = mvViewDepth(uv + S + o, float(layer),
                                    texture(uVelocity, vec3(uv + S + o, float(layer))).z);
            if (wn <= 0.0) continue;                 // nothing wrote there
            float d = w0 - wn;                       // >0 => neighbour is nearer
            if (d <= 0.0) continue;                  // behind us, not an occluder
            // Range limit, scaled with distance so the effect stays the same
            // size on screen as geometry recedes. Without it a distant
            // background silhouetted against near geometry occludes the whole
            // frame edge.
            float maxD = 0.05 * w0 + 0.02;
            if (d > maxD) continue;
            occ += d / (d + 0.5 * maxD);             // soft, saturating
        }
        float ao = 1.0 - pc.aoStrength * (occ / float(AO_TAPS));
        currA *= clamp(ao, 0.0, 1.0);
    }

    // ---- CONTACT SHADOWS: THE SHADOW THE SHADOW MAP IS TOO COARSE TO DRAW.
    //
    // Not a second helping of AO. AO darkens creases from every direction at
    // once and is there whether or not the sun is out; this is DIRECTIONAL -
    // it only darkens what the sun is actually blocked from reaching. That is
    // the short, hard shadowing a cascade never resolves: the strip under a
    // gear door on a sunlit ramp, the line where a strut meets the tarmac,
    // panel seams, the edge of a wing on the ground.
    //
    // The march is along the sun's direction PROJECTED INTO SCREEN SPACE. It is
    // not a true world-space ray - that would need the projection matrix, and
    // the push block is full to the byte. What it is instead is an occlusion
    // test restricted to one direction, which is enough to make the shading
    // directional and to make it move correctly as the sun moves.
    //
    // Hard where AO is soft, and deliberately: the first hit ends the march and
    // there is no distance-weighted softening. A contact shadow that fades out
    // looks like dirt.
    //
    // ON THE Y SIGN. The screen-space direction reuses pc.velYSign, because the
    // NDC-to-screen Y convention here is the same one the velocity buffer had
    // to be swept for. If shadows ever appear thrown to the wrong side of an
    // object, that sign is the first thing to test - not this block's logic.
    //
    // Sun below the horizon arrives as an all-zero vector and costs nothing.
    vec2 sunXY = vec2(pc.sunViewX, pc.sunViewY * pc.velYSign);
    float sunLen = length(sunXY);
    if (pc.csStrength > 0.0 && !unwritten && velS.z > 0.0 && sunLen > 0.05) {
        float w0 = mvViewDepth(uv + S, float(layer), velS.z);
        vec2  dir = sunXY / sunLen;
        // Shorter than the AO radius on purpose. Contact shadows are a contact
        // effect; marching them as far as the ambient term turns every silhou-
        // ette into a smear and starts fighting the shadow map's own edge.
        float csLen = pc.aoRadius * 0.5;
        // Same interleaved-gradient offset the AO uses, so the eight steps do
        // not land on the same eight depths across a flat surface and band it.
        float ign = fract(52.9829189 * fract(dot(vec2(px), vec2(0.06711056, 0.00583715))));
        const int CS_STEPS = 8;
        float shadow = 0.0;
        for (int i = 0; i < CS_STEPS; ++i) {
            float t = (float(i) + ign) / float(CS_STEPS);
            vec2  o = dir * (csLen * t) / vec2(size);
            float wn = mvViewDepth(uv + S + o, float(layer),
                                   texture(uVelocity, vec3(uv + S + o, float(layer))).z);
            if (wn <= 0.0) continue;                 // nothing wrote there
            float d = w0 - wn;                       // >0 => sample is nearer
            // A bias that GROWS along the march, standing in for the ray
            // climbing toward the sun. Without it a merely sloped surface
            // shadows itself and everything acquires a dark rim on the sunward
            // side - the classic self-shadowing acne.
            float bias = (0.004 + 0.02 * t) * w0;
            if (d <= bias) continue;
            // ---- AN OCCLUDER MUST BE CLOSE, AND "CLOSE" IS A DISTANCE IN
            // METRES, NOT A FRACTION OF HOW FAR AWAY WE ARE.
            //
            // This was 0.06 * w0 + 0.05, which is a percentage of view depth:
            // at 100 m it accepted anything within SIX METRES as a contact
            // occluder. That is not contact shading, it is a very short ambient
            // term, and it smeared darkness across ground nowhere near where
            // geometry actually touches.
            //
            // A contact shadow is by definition a near-field effect, so the
            // range is now a fixed world distance with only a small allowance
            // for depth precision falling off with distance.
            if (d > 0.35 + 0.002 * w0) continue;
            // ---- ACCUMULATE, DO NOT LATCH.
            //
            // This used to be `shadow = 1.0; break;` - binary, first hit wins.
            // A hard 0-or-1 term is the worst possible thing to feed a temporal
            // filter: uHistory is both the output AND the next frame's history,
            // so a value that flips full-on to full-off as the camera moves
            // makes the current frame disagree with history, the variance clamp
            // throws the history away, and accumulation collapses exactly when
            // the camera moves.
            //
            // Partial occlusion over the remaining steps is stable under small
            // camera motion because one tap changing its mind moves the result
            // by 1/8, not by 1. The edge stays tight because the steps are
            // short; it just stops being a step function.
            shadow += 1.0 / float(CS_STEPS);
        }
        shadow = clamp(shadow * 2.0, 0.0, 1.0);
        currA *= clamp(1.0 - pc.csStrength * shadow, 0.0, 1.0);
    }

    if ((pc.flags & FLAG_RESET) != 0 || !valid || noVector) {
        imageStore(uHistory, ivec3(px, layer), vec4(currA, 1.0));
        return;
    }

    vec3 hist = sampleHistory(hUv, float(layer), vec2(size));

    // History straight to screen, before anything is done to it. If this does
    // not smear along motion when frozen, what is displayed is not the history
    // and no amount of tuning the blend will change that.
    if (pc.viz == VIZ_HISTORY) {
        imageStore(uHistory, ivec3(px, layer), vec4(hist, 1.0));
        return;
    }

    // Keep every binding, barrier and dispatch live while removing exactly one
    // thing. FREEZE_HISTORY writes nothing at all, so the buffer retains what it
    // had; NO_ACCUM writes the current frame, so accumulation stops but the
    // pipeline does not.
    if ((pc.flags & FLAG_FREEZE_HISTORY) != 0) return;
    if ((pc.flags & FLAG_NO_ACCUM) != 0) {
        imageStore(uHistory, ivec3(px, layer), vec4(currA, 1.0));
        return;
    }

    // ---- MODE 3: the clean room. See the note at MODE_CLEAN.
    if (pc.mode == MODE_CLEAN) {
        vec2 tszC = 1.0 / vec2(size);
        // Neighbourhood in LINEAR space - no tonemap, so no inverse is ever
        // needed and the epsilon that broke earlier attempts cannot arise.
        vec3 cmin = vec3( 1e30), cmax = vec3(-1e30);
        for (int dy = -1; dy <= 1; ++dy)
            for (int dx = -1; dx <= 1; ++dx) {
                // AT uv + S, LIKE currA. Without S the box is built from a
                // neighbourhood displaced by this frame's jitter while the
                // sample it bounds is not, so the two disagree by up to half a
                // pixel and the disagreement CHANGES EVERY FRAME with the
                // Halton phase. On high-frequency ground the min/max of a
                // shifting 3x3 then differs frame to frame, history is clamped
                // into a different range each time, and a still camera over
                // still grass produces a picture that will not sit still. That
                // is the shake, and it is why jitter_scale=0 removed it: at
                // zero, S is zero and the two positions coincide.
                vec3 s = texture(uScene,
                          vec3(uv + S + vec2(dx, dy) * tszC, float(layer))).rgb;
                cmin = min(cmin, s);
                cmax = max(cmax, s);
            }
        // History along the motion vector, clamped into that range. A sample
        // outside every colour around it cannot belong to this pixel, whatever
        // the vector claimed - that single rule is what stops ghosting, and it
        // needs no variance, no gain and no coverage channel.
        vec3 h = sampleHistory(hUv, float(layer), vec2(size));
        h = clamp(h, cmin, cmax);
        // First frame, a reset, or a reprojection that left the screen: take
        // the current frame whole rather than blending against nothing.
        bool bad = (pc.flags & FLAG_RESET) != 0 ||
                   hUv.x < 0.0 || hUv.x > 1.0 || hUv.y < 0.0 || hUv.y > 1.0;
        // ---- A PIXEL WITH NO VECTOR CANNOT FOLLOW THE CAMERA.
        //
        // Keeping its history at the same texel is what makes the ground
        // crawl: the world shifts under it by the camera's own micro-motion
        // and the stale sample is dragged along. Throwing it away instead is
        // the shake this build just removed. Decaying it is neither - the
        // stale contribution is gone in a few frames, so the ground stops
        // creeping, and nothing is refreshed hard enough to flicker.
        float aEff = unwritten ? max(pc.alpha, pc.novecAlpha) : pc.alpha;
        vec3 o = bad ? currA : mix(h, currA, aEff);
        imageStore(uHistory, ivec3(px, layer), vec4(max(o, vec3(0.0)), 1.0));
        return;
    }

    // ---- STAGE 1: reprojection only, no rejection.
    //
    // Ghosting here is expected and diagnostic: it means history is being
    // fetched and blended, and that the velocity is steering it. A frame that
    // ghosts along motion is a frame whose reprojection works.
    if (pc.mode == MODE_REPROJECT) {
        vec3 outc = mix(hist, currA, pc.alpha);
        imageStore(uHistory, ivec3(px, layer), vec4(outc, 1.0));
        return;
    }

    // ---- STAGE 2: neighbourhood clamp.
    //
    // History that falls outside the range of the current 3x3 neighbourhood is
    // stale - a disocclusion, or a shading change the vectors cannot express.
    // Clamping to that range keeps the sample that is still valid and discards
    // the part that is not, which is what stops ghosting without giving up
    // accumulation everywhere.
    // ---- STATISTICS IN TONEMAPPED SPACE. BLEND IN LINEAR. NEVER INVERT.
    //
    // This is the third attempt and the reasoning matters, because the second
    // one was clever and produced a black screen.
    //
    // Attempt 1 computed the box on raw HDR values. A specular highlight is
    // fifty times the neighbourhood mean there, so sigma is enormous, the clamp
    // barely constrains history, and bright areas keep smearing - the glare
    // that grows as you move. Per-channel clamping in YCoCg can also leave the
    // RGB hull, which inverts back to NEGATIVE rgb: the black dots along
    // high-contrast edges when the camera moves.
    //
    // Attempt 2 applied Karis' reversible weighting - blend in c/(1+luma), then
    // undo it. Both defects are addressed in theory, and untm blew up in
    // practice: the clamped value's luma can reach 1, so 1-luma hits its epsilon
    // floor and the pixel is multiplied by ten thousand. White fireflies frame
    // wide.
    //
    // The inverse was never needed. Only the STATISTICS have to be computed on
    // values of comparable size - the mean, the variance, the box, and the
    // weight derived from them. The blend itself can then be applied to the
    // linear colours with that weight. Nothing is ever mapped back, so there is
    // no epsilon and nothing to divide by.
    vec3 m1 = vec3(0.0), m2 = vec3(0.0);
    vec3 nmin = vec3( 1e30), nmax = vec3(-1e30);
    // ---- THE NEIGHBOURHOOD MUST BE READ WHERE THE CENTRE WAS READ.
    //
    // These taps used texelFetch at integer pixels while the centre sample is
    // taken at uv + S, the jittered position where the geometry actually is.
    // With jitter armed the box was therefore built from a raster half a pixel
    // away from the sample it judges, in a DIFFERENT direction every frame, so
    // history was accepted on one frame and clipped on the next across the
    // whole image. That is the shake that appeared only with jitter on and
    // survived every other fix - the clamp was fighting the jitter it was never
    // told about.
    //
    // Sampling with the same offset costs a filtered fetch instead of a texel
    // fetch and puts the statistics in the sample's own frame of reference.
    vec2 tsz = 1.0 / vec2(size);
    for (int dy = -1; dy <= 1; ++dy) {
        for (int dx = -1; dx <= 1; ++dx) {
            vec2  quv = uv + S + vec2(dx, dy) * tsz;
            vec3  c = rgb2ycocg(tm(texture(uScene, vec3(quv, float(layer))).rgb));
            m1 += c;
            m2 += c * c;
            nmin = min(nmin, c);
            nmax = max(nmax, c);
        }
    }

    // Variance clipping, tightened against the hard min/max. The box alone is
    // too permissive on noisy content and lets fireflies persist; the variance
    // term narrows it where the neighbourhood actually agrees.
    vec3 mu    = m1 / 9.0;
    vec3 sigma = sqrt(max(m2 / 9.0 - mu * mu, vec3(0.0)));
    // ---- TIGHTER IN THE DARK.
    //
    // The shadow interiors mottled because X-Plane dithers its soft shadows
    // per frame and the clamp box, sized by variance, is WIDE exactly where
    // that dither is the dominant signal - so bright dither outliers inside a
    // shadow passed as plausible and parked. Luminance says which regime a
    // pixel is in: below ~2% luminance the box narrows to just over half its
    // width, fading back to full by ~15%. Scaled from pc.varClip so the live
    // knob still moves the whole family together.
    float clipK = pc.varClip * mix(0.55, 1.0,
                                   smoothstep(0.02, 0.15, luma(tm(currA))));
    vec3 lo    = max(mu - clipK * sigma, nmin);
    vec3 hi    = min(mu + clipK * sigma, nmax);

    vec3 hRaw = rgb2ycocg(tm(hist));
    vec3 hy   = clamp(hRaw, lo, hi);

    // ---- HOW FAR THE CLAMP HAD TO MOVE HISTORY, MEASURED SAFELY.
    //
    // A large correction means history was wrong, so trusting it less is
    // cheaper than a second rejection heuristic. But the ratio needs a
    // denominator that cannot vanish independently of the numerator.
    //
    // The floor was an absolute 1e-4, and in a flat region - a sky gradient, a
    // smooth fuselage - both sigma and |hy - hRaw| go to zero together. That
    // makes `moved` a ratio of two vanishing quantities with a floor on only
    // one of them, so a correction far too small to see could drive the weight
    // to 1.0 and kill accumulation exactly where it matters most.
    //
    // Flooring relative to the signal fixes it: below a hundredth of the local
    // luminance the neighbourhood genuinely agrees, history is genuinely fine,
    // and `moved` should read as zero rather than as noise amplified.
    float floorS = 0.01 * luma(tm(currA)) + 1e-4;
    // ---- A DEADBAND, DEFAULT OFF, AND WHY ITS EVIDENCE WAS WORTHLESS.
    //
    // The note above says a correction below the noise floor means history is
    // fine and `moved` should read as zero. The code floors only the
    // DENOMINATOR, which does not do that, so the deadband below implements
    // the sentence as written.
    //
    // It is DEFAULT OFF, because the measurement that motivated it was void.
    // moved was read as ~25 at rest via viz=6, and a as 1.0 via viz=5 - but
    // BOTH of those viz modes imageStore into uHistory and return, so while
    // either is on, history IS THE PREVIOUS FRAME'S HEATMAP. moved then
    // saturates by construction and a pins at 1.0, whatever the resolve is
    // really doing. The measurement created the condition it measured, which
    // is the exact trap the direct-history-readback note in taa.h was written
    // to warn about.
    //
    // What survived: at gain=0, alpha=0.02, captured at viz=0 so history was
    // clean, the image was normal and frozen frame to frame (mean delta 0.06).
    // History is real and it accumulates. There is no "TAA never accumulates"
    // bug; that conclusion came entirely from contaminated viz.
    //
    // So this stays available and inert. Anything that turns it on must be
    // justified by a viz=0 measurement - a readback or a composited-image
    // statistic - never by viz=5 or viz=6.
    float dHist  = length(hy - hRaw);
    float moved  = max(dHist - pc.movedDead * floorS, 0.0)
                 / max(length(sigma), floorS);

    // ---- THE CLAMP DRIVES THE WEIGHT. IT IS NOT APPLIED TO THE COLOUR.
    //
    // This is the part attempt 2 got wrong, and it is worth being precise about
    // why, because the obvious repair is to keep the clamp and pick a safer
    // epsilon - which is the same bug with a smaller blast radius.
    //
    // tm(c) = c / (1 + luma(c)) inverts to tm(c) / (1 - luma(tm(c))). There is
    // no other inverse: recovering a linear colour from a value that was
    // CLAMPED in tonemapped space requires that division, and the clamp is
    // per-channel in YCoCg, so it can push luma to 1 and make the divisor zero.
    // Any epsilon there is a cap on how large a wrong answer gets, not a fix.
    //
    // So the clamp is never inverted. It is used for what it actually measures:
    // HOW WRONG HISTORY IS. `moved` is that distance in units of the local
    // standard deviation, and it drives the weight instead of the colour. A
    // disoccluded pixel, where the clamp would have snapped history a long way,
    // now gets a weight at or near 1.0 and simply takes the current frame - the
    // same outcome, reached without ever leaving linear space.
    //
    // The gain is 4.0 rather than the 0.5 used when clamping did most of the
    // work: at `moved` = 1, one standard deviation out, history is already
    // suspect, and the weight should be most of the way to the current frame.
    // Everything here is a multiply, an add and a clamp - nothing divides by a
    // quantity that can vanish, so there is no configuration of inputs that
    // produces a firefly or a black pixel.
    // ---- HISTORY MUST BE SHORTER WHILE THE CAMERA MOVES.
    //
    // taa.alpha_moving has been in the settings file the whole time, plumbed
    // NOWHERE - not in this shader, not in the layer. It was meant to do this,
    // and never did.
    //
    // Why it is needed, measured: with alpha 1.0 (no history at all) the smear
    // is GONE; with alpha 0.05 it is back. So the smear is accumulation, not
    // reprojection - the vectors were checked against image flow and are right,
    // and vel_scale, varclip, gain, the resampling filter and unjitter were each
    // swept with no effect on it.
    //
    // At alpha 0.05 a sample survives about twenty frames. The ground moves 12
    // to 45 px per frame under a pan, so a velocity error of even 2% drifts a
    // quarter to nine tenths of a pixel per frame and lands 5 to 18 px away by
    // the time the sample dies. That is the trail, on the ground and along the
    // trees alike.
    //
    // It also explains why the CLAMP could not catch it. A slow drift stays
    // INSIDE the neighbourhood colour range - it is a plausible value in the
    // wrong place - so tightening varclip from 8.0 to 1.25 changed nothing.
    // Only shortening the history does.
    //
    // Parked, the long history is exactly what is wanted: that is the jitter
    // accumulation doing the anti-aliasing, and it is why alpha cannot simply
    // be raised globally.
    // ---- RAMP ON THIS PIXEL'S SPEED, NOT ON A WHOLE-FRAME FLAG.
    //
    // The first version of this keyed on pc.cameraMoved, and that flag is
    // binary and frame-wide. This file already records why that cannot work:
    // the airframe trembles on its gear with the engines running, so
    // cameraMoved is TRUE on a parked aeroplane. Worse, it flickers - so alpha
    // alternated 0.05 / 0.35 frame to frame, history alternated long / short,
    // and the picture pumped. Measured parked: flicker 0.310 against 0.080
    // with the same settings and this term inert, where TAA off is 0.058. It
    // traded the smear for a shimmer, which is not a fix.
    //
    // Per-pixel speed has neither problem. It is continuous, so there is
    // nothing to alternate; it is local, so a pan that moves the ground 40 px
    // and the horizon 2 px shortens history only where the error would
    // actually compound; and a tremble is a fraction of a pixel, which the
    // ramp reads as stationary.
    //
    // Below alphaMovingPx the two blend smoothly, so nothing switches.
    float speedPx = length(vel * vec2(size));
    float t       = clamp(speedPx / max(pc.alphaMovingPx, 1e-3), 0.0, 1.0);
    float aBase   = mix(pc.alpha, max(pc.alpha, pc.alphaMoving), t);
    float a = clamp(aBase + pc.gain * moved * aBase, aBase, 1.0);

    // Moving-geometry pixels take the current frame outright - see uFlags.
    if (pc.flagsValid != 0) {
        // Clamped, unconditionally. texelFetch performs no bounds checking,
        // and this fetch runs at full-frame coordinates against whatever is
        // bound - which is the 1x1 fallback whenever the real image is
        // unidentified. The branch above should keep the fallback unfetched,
        // but an out-of-bounds texelFetch is undefined behaviour of exactly
        // the kind that becomes VK_ERROR_DEVICE_LOST on a driver that hoists,
        // and a clamp costs two instructions against losing the device.
        ivec3 fsz = textureSize(uFlags, 0);
        ivec2 fpx = min(px, fsz.xy - 1);
        uint fl = texelFetch(uFlags, ivec3(fpx, min(layer, fsz.z - 1)), 0).r;
        if ((fl & 4u) != 0u) a = 1.0;
    }
    // Transparent-covered pixels likewise - the C14 reactive mask. See the
    // coverage note at the fetch.
    // ---- COVERAGE CANNOT BE JUDGED WHERE NOTHING WROTE.
    //
    // The velocity attachment is bound on the scene passes only. Anything
    // drawn outside them leaves the CLEAR value, and the clear sets .x and .y
    // to the sentinel while .z and .w default to zero. Coverage zero reads as
    // "fully transparent", so the mask fired on every such pixel, pinned the
    // blend weight to 1.0, and stopped those pixels accumulating - they never
    // anti-aliased and they shimmered with the jitter.
    //
    // `unwritten` already identifies exactly those pixels, by the sentinel
    // rather than by inference. Where nothing wrote a vector, nothing wrote a
    // coverage either, and the mask has no evidence to act on.
    if ((pc.flags & FLAG_REACTIVE) != 0 && !unwritten && covMax < 0.5)
        a = max(a, pc.reactiveAlpha);

    // How far the clamp had to move history, in standard deviations. Edges under
    // motion should light up and flat interiors should stay black; a frame that
    // is bright everywhere means the box is too tight, and one that is black
    // everywhere means it is not constraining anything.
    if (pc.viz == VIZ_CLAMP) {
        imageStore(uHistory, ivec3(px, layer),
                   vec4(heat(moved * 0.5 * pc.vizScale), 1.0));
        return;
    }
    // The weight actually used. Black is full accumulation, white is the current
    // frame only, so disocclusion edges glow and everything static stays dark.
    // This is the view that says whether alpha is doing what the number says.
    if (pc.viz == VIZ_WEIGHT) {
        imageStore(uHistory, ivec3(px, layer),
                   vec4(heat(a * pc.vizScale), 1.0));
        return;
    }

    // The negative-component floor stays. Those were the black dots along
    // high-contrast edges, and flooring costs nothing.
    vec3 outc = max(mix(hist, currA, a), vec3(0.0));

    // ---- ALPHA CARRIES CONFIDENCE, SO THE SHARPEN PASS CAN SEE IT.
    //
    // History is RGBA16F and its alpha wrote a constant 1.0 that nothing ever
    // read. The sharpen pass runs as a separate dispatch with an early return,
    // so it has no access to a, moved or covMax - which is why it sharpens a
    // disoccluded pixel exactly as hard as a fully converged one, and why
    // disocclusion trails crawl.
    //
    // a IS the confidence: 0 means the pixel is entirely accumulated history,
    // 1 means it is raw current frame with nothing behind it. Storing it here
    // costs nothing and hands the next pass the one number it was missing.
    imageStore(uHistory, ivec3(px, layer), vec4(outc, a));
}
