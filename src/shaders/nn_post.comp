#version 450
// ================================================================ NN POST
//
// The AA net's output stage: out = base + tanh(r) * (0.5 + |base|), the
// bounded residual the net was trained with (quick_train.ResidualSR). `r` is
// the last conv's pre-activation (map uR, layer 0, rgb); `base` is the
// unjittered current-frame fetch the resolve stored in the input map's layer 4
// (yzw), BEFORE its AO / contact-shadow modulation. Layer 5 holds that
// modulation as a per-channel factor so the net's output gets the same shading
// the resolve's own output got.
//
// The result replaces the resolve's output in the history image for x < split
// of the width; the rest of the frame stays the resolve's, which is the live
// A/B seam. Alpha (the resolve's confidence) is kept as written.
//
// viz 1 draws |net - resolve| * 8, so the seam and the residual are visible
// without a screenshot diff.
//
// Copyright (C) 2026 MotionVectors contributors
// SPDX-License-Identifier: GPL-3.0-or-later

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0, rgba16f) uniform readonly image2DArray uR;      // last conv output, layer 0
layout(binding = 1, rgba16f) uniform readonly image2DArray uIn;     // the net input map (base in layer 4, shading in layer 5)
layout(binding = 2, rgba16f) uniform image2DArray uHist;            // the resolve's history/output image, this frame's write side
layout(binding = 3, rgba16f) uniform writeonly image2DArray uFin;   // the delivered frame (no-feedback mode): net left, resolve right

layout(push_constant) uniform P {
    ivec2 size;
    int   layer;      // history array layer
    int   viz;
    float split;
    float blend;      // 1 = net output, 0 = resolve (a live dial)
    int   feedback;   // 1: write the history (the net recurs on itself); 0: write uFin only, history stays the resolve's
} pc;

void main()
{
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= pc.size.x || px.y >= pc.size.y) return;

    vec4 prev = imageLoad(uHist, ivec3(px, pc.layer));
    const bool netSide = float(px.x) < pc.split * float(pc.size.x);
    // ---- NO FEEDBACK BY DEFAULT. The net was trained on three-step unrolls; recurring on its
    // own output for thousands of frames grew a diagonal hatch on grass that halved with the
    // blend (first working flight, 2026-09-12). With feedback off the history stays the
    // resolve's - the input the net saw at step 0 of every training window - and the net's
    // frame goes to the screen only, through the sharpen and the copy-out.
    if (!netSide && pc.viz == 0) {
        if (pc.feedback == 0) imageStore(uFin, ivec3(px, pc.layer), prev);
        return;
    }

    vec3 r    = imageLoad(uR,  ivec3(px, 0)).rgb;
    vec3 base = imageLoad(uIn, ivec3(px, 4)).yzw;
    vec3 shade = imageLoad(uIn, ivec3(px, 5)).xyz;
    vec3 o = base + tanh(r) * (0.5 + abs(base));
    o = max(o * shade, vec3(0.0));
    // ---- BOUNDED, ALWAYS. The history is rgba16f and X-Plane's auto-exposure averages the
    // frame: one pixel pushed past 65504 by base * shade on the sun disk becomes +inf, the
    // exposure follows it and the WHOLE screen goes black (first flight, 2026-09-12). The net
    // may not brighten beyond twice what the resolve would show, and never produces inf/NaN.
    o = min(o, max(prev.rgb, base) * 2.0 + 1.0);
    o = min(o, vec3(30000.0));
    if (any(isnan(o)) || any(isinf(o))) o = prev.rgb;
    // ---- THE SAME RANGE THE TRUTH WAS BUILT WITH. pack_aa.py accepted a warped sample only
    // inside the current raster's 3x3 tonemapped range +- 0.03, so the target never left that
    // box; at run time the net recurs on its own output for thousands of frames (trained on
    // three), and a pattern that crept outside the box would feed on itself. Clamping the
    // tonemapped output to the box the truth lived in costs eight loads and removes nothing
    // the training could have asked for.
    if (pc.viz != 2) {
        vec3 lo = vec3(1e30), hi = vec3(-1e30);
        for (int dy = -1; dy <= 1; ++dy)
            for (int dx = -1; dx <= 1; ++dx) {
                ivec2 q = clamp(px + ivec2(dx, dy), ivec2(0), pc.size - 1);
                vec3 b = imageLoad(uIn, ivec3(q, 4)).yzw;
                vec3 t = b / (1.0 + dot(b, vec3(0.2126, 0.7152, 0.0722)));
                lo = min(lo, t); hi = max(hi, t);
            }
        vec3 ot = o / (1.0 + dot(o, vec3(0.2126, 0.7152, 0.0722)));
        vec3 ct = clamp(ot, lo - 0.03, hi + 0.03);
        float lt = dot(ct, vec3(0.2126, 0.7152, 0.0722));
        o = ct / max(1.0 - lt, 1e-4);
    }

    vec4 res = (pc.viz == 1) ? vec4(abs(o - prev.rgb) * 8.0, prev.a)
             : (netSide ? vec4(mix(prev.rgb, o, clamp(pc.blend, 0.0, 1.0)), prev.a) : prev);
    if (pc.feedback != 0) {
        if (netSide || pc.viz == 1) imageStore(uHist, ivec3(px, pc.layer), res);
    } else {
        imageStore(uFin, ivec3(px, pc.layer), res);
    }
}
